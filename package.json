{
  "name": "date-dimension",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "typecheck": "tsc --noEmit",
    "lint": "bash scripts/sites-env.sh -- eslint .",
    "test:unit": "node --experimental-strip-types --test \"tests/unit/**/*.test.mjs\"",
    "test:integration": "node --experimental-strip-types --test \"tests/integration/**/*.test.mjs\"",
    "test": "npm run test:unit && npm run build && npm run test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "credentials": "node --experimental-strip-types --no-warnings scripts/credentials.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit"
  },
  "dependencies": {
    "@photostructure/tz-lookup": "^11.7.0",
    "adhan": "^4.4.6",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.60.1",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.9",
    "react-server-dom-webpack": "19.3.0",
    "typescript": "5.9.3",
    "vinext": "0.2.1",
    "vite": "8.3.1",
    "wrangler": "4.140.0"
  },
  "type": "module",
  "overrides": {
    "sharp": "^0.35.0",
    "postcss": "^8.5.28"
  }
}
