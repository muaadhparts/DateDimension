{"number":84,"name":"سُورَةُ الانشِقَاقِ","englishName":"Al-Inshiqaaq","englishNameTranslation":"The Splitting Open","revelationType":"Meccan","basmala":true,"verses":[{"number":1,"text":"إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ","page":589,"juz":30,"sajda":false},{"number":2,"text":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ","page":589,"juz":30,"sajda":false},{"number":3,"text":"وَإِذَا ٱلْأَرْضُ مُدَّتْ","page":589,"juz":30,"sajda":false},{"number":4,"text":"وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ","page":589,"juz":30,"sajda":false},{"number":5,"text":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ","page":589,"juz":30,"sajda":false},{"number":6,"text":"يَٰٓأَيُّهَا ٱلْإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًۭا فَمُلَٰقِيهِ","page":589,"juz":30,"sajda":false},{"number":7,"text":"فَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِيَمِينِهِۦ","page":589,"juz":30,"sajda":false},{"number":8,"text":"فَسَوْفَ يُحَاسَبُ حِسَابًۭا يَسِيرًۭا","page":589,"juz":30,"sajda":false},{"number":9,"text":"وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُورًۭا","page":589,"juz":30,"sajda":false},{"number":10,"text":"وَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ وَرَآءَ ظَهْرِهِۦ","page":589,"juz":30,"sajda":false},{"number":11,"text":"فَسَوْفَ يَدْعُوا۟ ثُبُورًۭا","page":589,"juz":30,"sajda":false},{"number":12,"text":"وَيَصْلَىٰ سَعِيرًا","page":589,"juz":30,"sajda":false},{"number":13,"text":"إِنَّهُۥ كَانَ فِىٓ أَهْلِهِۦ مَسْرُورًا","page":589,"juz":30,"sajda":false},{"number":14,"text":"إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ","page":589,"juz":30,"sajda":false},{"number":15,"text":"بَلَىٰٓ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرًۭا","page":589,"juz":30,"sajda":false},{"number":16,"text":"فَلَآ أُقْسِمُ بِٱلشَّفَقِ","page":589,"juz":30,"sajda":false},{"number":17,"text":"وَٱلَّيْلِ وَمَا وَسَقَ","page":589,"juz":30,"sajda":false},{"number":18,"text":"وَٱلْقَمَرِ إِذَا ٱتَّسَقَ","page":589,"juz":30,"sajda":false},{"number":19,"text":"لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍۢ","page":589,"juz":30,"sajda":false},{"number":20,"text":"فَمَا لَهُمْ لَا يُؤْمِنُونَ","page":589,"juz":30,"sajda":false},{"number":21,"text":"وَإِذَا قُرِئَ عَلَيْهِمُ ٱلْقُرْءَانُ لَا يَسْجُدُونَ ۩","page":589,"juz":30,"sajda":true},{"number":22,"text":"بَلِ ٱلَّذِينَ كَفَرُوا۟ يُكَذِّبُونَ","page":589,"juz":30,"sajda":false},{"number":23,"text":"وَٱللَّهُ أَعْلَمُ بِمَا يُوعُونَ","page":589,"juz":30,"sajda":false},{"number":24,"text":"فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ","page":589,"juz":30,"sajda":false},{"number":25,"text":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۭ","page":589,"juz":30,"sajda":false}]}
