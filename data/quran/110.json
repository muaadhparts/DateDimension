{"number":110,"name":"سُورَةُ النَّصۡرِ","englishName":"An-Nasr","englishNameTranslation":"Divine Support","revelationType":"Medinan","basmala":true,"verses":[{"number":1,"text":"إِذَا جَآءَ نَصْرُ ٱللَّهِ وَٱلْفَتْحُ","page":603,"juz":30,"sajda":false},{"number":2,"text":"وَرَأَيْتَ ٱلنَّاسَ يَدْخُلُونَ فِى دِينِ ٱللَّهِ أَفْوَاجًۭا","page":603,"juz":30,"sajda":false},{"number":3,"text":"فَسَبِّحْ بِحَمْدِ رَبِّكَ وَٱسْتَغْفِرْهُ ۚ إِنَّهُۥ كَانَ تَوَّابًۢا","page":603,"juz":30,"sajda":false}]}
