{"number":113,"name":"سُورَةُ الفَلَقِ","englishName":"Al-Falaq","englishNameTranslation":"The Dawn","revelationType":"Meccan","basmala":true,"verses":[{"number":1,"text":"قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ","page":604,"juz":30,"sajda":false},{"number":2,"text":"مِن شَرِّ مَا خَلَقَ","page":604,"juz":30,"sajda":false},{"number":3,"text":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ","page":604,"juz":30,"sajda":false},{"number":4,"text":"وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِى ٱلْعُقَدِ","page":604,"juz":30,"sajda":false},{"number":5,"text":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ","page":604,"juz":30,"sajda":false}]}
