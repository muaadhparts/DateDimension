{"number":94,"name":"سُورَةُ الشَّرۡحِ","englishName":"Ash-Sharh","englishNameTranslation":"The Consolation","revelationType":"Meccan","basmala":true,"verses":[{"number":1,"text":"أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ","page":596,"juz":30,"sajda":false},{"number":2,"text":"وَوَضَعْنَا عَنكَ وِزْرَكَ","page":596,"juz":30,"sajda":false},{"number":3,"text":"ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ","page":596,"juz":30,"sajda":false},{"number":4,"text":"وَرَفَعْنَا لَكَ ذِكْرَكَ","page":596,"juz":30,"sajda":false},{"number":5,"text":"فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","page":596,"juz":30,"sajda":false},{"number":6,"text":"إِنَّ مَعَ ٱلْعُسْرِ يُسْرًۭا","page":596,"juz":30,"sajda":false},{"number":7,"text":"فَإِذَا فَرَغْتَ فَٱنصَبْ","page":596,"juz":30,"sajda":false},{"number":8,"text":"وَإِلَىٰ رَبِّكَ فَٱرْغَب","page":596,"juz":30,"sajda":false}]}
