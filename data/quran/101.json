{"number":101,"name":"سُورَةُ القَارِعَةِ","englishName":"Al-Qaari'a","englishNameTranslation":"The Calamity","revelationType":"Meccan","basmala":true,"verses":[{"number":1,"text":"ٱلْقَارِعَةُ","page":600,"juz":30,"sajda":false},{"number":2,"text":"مَا ٱلْقَارِعَةُ","page":600,"juz":30,"sajda":false},{"number":3,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ","page":600,"juz":30,"sajda":false},{"number":4,"text":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ","page":600,"juz":30,"sajda":false},{"number":5,"text":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ","page":600,"juz":30,"sajda":false},{"number":6,"text":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ","page":600,"juz":30,"sajda":false},{"number":7,"text":"فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ","page":600,"juz":30,"sajda":false},{"number":8,"text":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ","page":600,"juz":30,"sajda":false},{"number":9,"text":"فَأُمُّهُۥ هَاوِيَةٌۭ","page":600,"juz":30,"sajda":false},{"number":10,"text":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ","page":600,"juz":30,"sajda":false},{"number":11,"text":"نَارٌ حَامِيَةٌۢ","page":600,"juz":30,"sajda":false}]}
