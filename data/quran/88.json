{"number":88,"name":"سُورَةُ الغَاشِيَةِ","englishName":"Al-Ghaashiya","englishNameTranslation":"The Overwhelming","revelationType":"Meccan","basmala":true,"verses":[{"number":1,"text":"هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَٰشِيَةِ","page":592,"juz":30,"sajda":false},{"number":2,"text":"وُجُوهٌۭ يَوْمَئِذٍ خَٰشِعَةٌ","page":592,"juz":30,"sajda":false},{"number":3,"text":"عَامِلَةٌۭ نَّاصِبَةٌۭ","page":592,"juz":30,"sajda":false},{"number":4,"text":"تَصْلَىٰ نَارًا حَامِيَةًۭ","page":592,"juz":30,"sajda":false},{"number":5,"text":"تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍۢ","page":592,"juz":30,"sajda":false},{"number":6,"text":"لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍۢ","page":592,"juz":30,"sajda":false},{"number":7,"text":"لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍۢ","page":592,"juz":30,"sajda":false},{"number":8,"text":"وُجُوهٌۭ يَوْمَئِذٍۢ نَّاعِمَةٌۭ","page":592,"juz":30,"sajda":false},{"number":9,"text":"لِّسَعْيِهَا رَاضِيَةٌۭ","page":592,"juz":30,"sajda":false},{"number":10,"text":"فِى جَنَّةٍ عَالِيَةٍۢ","page":592,"juz":30,"sajda":false},{"number":11,"text":"لَّا تَسْمَعُ فِيهَا لَٰغِيَةًۭ","page":592,"juz":30,"sajda":false},{"number":12,"text":"فِيهَا عَيْنٌۭ جَارِيَةٌۭ","page":592,"juz":30,"sajda":false},{"number":13,"text":"فِيهَا سُرُرٌۭ مَّرْفُوعَةٌۭ","page":592,"juz":30,"sajda":false},{"number":14,"text":"وَأَكْوَابٌۭ مَّوْضُوعَةٌۭ","page":592,"juz":30,"sajda":false},{"number":15,"text":"وَنَمَارِقُ مَصْفُوفَةٌۭ","page":592,"juz":30,"sajda":false},{"number":16,"text":"وَزَرَابِىُّ مَبْثُوثَةٌ","page":592,"juz":30,"sajda":false},{"number":17,"text":"أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ","page":592,"juz":30,"sajda":false},{"number":18,"text":"وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ","page":592,"juz":30,"sajda":false},{"number":19,"text":"وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ","page":592,"juz":30,"sajda":false},{"number":20,"text":"وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ","page":592,"juz":30,"sajda":false},{"number":21,"text":"فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌۭ","page":592,"juz":30,"sajda":false},{"number":22,"text":"لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ","page":592,"juz":30,"sajda":false},{"number":23,"text":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ","page":592,"juz":30,"sajda":false},{"number":24,"text":"فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ","page":592,"juz":30,"sajda":false},{"number":25,"text":"إِنَّ إِلَيْنَآ إِيَابَهُمْ","page":592,"juz":30,"sajda":false},{"number":26,"text":"ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم","page":592,"juz":30,"sajda":false}]}
