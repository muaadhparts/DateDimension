{"page":536,"blocks":[{"surah":56,"name":"سُورَةُ الوَاقِعَةِ","englishName":"Al-Waaqia","basmala":false,"juz":27,"verses":[{"number":51,"text":"ثُمَّ إِنَّكُمْ أَيُّهَا ٱلضَّآلُّونَ ٱلْمُكَذِّبُونَ","sajda":false},{"number":52,"text":"لَءَاكِلُونَ مِن شَجَرٍۢ مِّن زَقُّومٍۢ","sajda":false},{"number":53,"text":"فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ","sajda":false},{"number":54,"text":"فَشَٰرِبُونَ عَلَيْهِ مِنَ ٱلْحَمِيمِ","sajda":false},{"number":55,"text":"فَشَٰرِبُونَ شُرْبَ ٱلْهِيمِ","sajda":false},{"number":56,"text":"هَٰذَا نُزُلُهُمْ يَوْمَ ٱلدِّينِ","sajda":false},{"number":57,"text":"نَحْنُ خَلَقْنَٰكُمْ فَلَوْلَا تُصَدِّقُونَ","sajda":false},{"number":58,"text":"أَفَرَءَيْتُم مَّا تُمْنُونَ","sajda":false},{"number":59,"text":"ءَأَنتُمْ تَخْلُقُونَهُۥٓ أَمْ نَحْنُ ٱلْخَٰلِقُونَ","sajda":false},{"number":60,"text":"نَحْنُ قَدَّرْنَا بَيْنَكُمُ ٱلْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ","sajda":false},{"number":61,"text":"عَلَىٰٓ أَن نُّبَدِّلَ أَمْثَٰلَكُمْ وَنُنشِئَكُمْ فِى مَا لَا تَعْلَمُونَ","sajda":false},{"number":62,"text":"وَلَقَدْ عَلِمْتُمُ ٱلنَّشْأَةَ ٱلْأُولَىٰ فَلَوْلَا تَذَكَّرُونَ","sajda":false},{"number":63,"text":"أَفَرَءَيْتُم مَّا تَحْرُثُونَ","sajda":false},{"number":64,"text":"ءَأَنتُمْ تَزْرَعُونَهُۥٓ أَمْ نَحْنُ ٱلزَّٰرِعُونَ","sajda":false},{"number":65,"text":"لَوْ نَشَآءُ لَجَعَلْنَٰهُ حُطَٰمًۭا فَظَلْتُمْ تَفَكَّهُونَ","sajda":false},{"number":66,"text":"إِنَّا لَمُغْرَمُونَ","sajda":false},{"number":67,"text":"بَلْ نَحْنُ مَحْرُومُونَ","sajda":false},{"number":68,"text":"أَفَرَءَيْتُمُ ٱلْمَآءَ ٱلَّذِى تَشْرَبُونَ","sajda":false},{"number":69,"text":"ءَأَنتُمْ أَنزَلْتُمُوهُ مِنَ ٱلْمُزْنِ أَمْ نَحْنُ ٱلْمُنزِلُونَ","sajda":false},{"number":70,"text":"لَوْ نَشَآءُ جَعَلْنَٰهُ أُجَاجًۭا فَلَوْلَا تَشْكُرُونَ","sajda":false},{"number":71,"text":"أَفَرَءَيْتُمُ ٱلنَّارَ ٱلَّتِى تُورُونَ","sajda":false},{"number":72,"text":"ءَأَنتُمْ أَنشَأْتُمْ شَجَرَتَهَآ أَمْ نَحْنُ ٱلْمُنشِـُٔونَ","sajda":false},{"number":73,"text":"نَحْنُ جَعَلْنَٰهَا تَذْكِرَةًۭ وَمَتَٰعًۭا لِّلْمُقْوِينَ","sajda":false},{"number":74,"text":"فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ","sajda":false},{"number":75,"text":"۞ فَلَآ أُقْسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ","sajda":false},{"number":76,"text":"وَإِنَّهُۥ لَقَسَمٌۭ لَّوْ تَعْلَمُونَ عَظِيمٌ","sajda":false}]}],"juz":27}
