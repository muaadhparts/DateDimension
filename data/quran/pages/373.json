{"page":373,"blocks":[{"surah":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa","basmala":false,"juz":19,"verses":[{"number":137,"text":"إِنْ هَٰذَآ إِلَّا خُلُقُ ٱلْأَوَّلِينَ","sajda":false},{"number":138,"text":"وَمَا نَحْنُ بِمُعَذَّبِينَ","sajda":false},{"number":139,"text":"فَكَذَّبُوهُ فَأَهْلَكْنَٰهُمْ ۗ إِنَّ فِى ذَٰلِكَ لَءَايَةًۭ ۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ","sajda":false},{"number":140,"text":"وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ","sajda":false},{"number":141,"text":"كَذَّبَتْ ثَمُودُ ٱلْمُرْسَلِينَ","sajda":false},{"number":142,"text":"إِذْ قَالَ لَهُمْ أَخُوهُمْ صَٰلِحٌ أَلَا تَتَّقُونَ","sajda":false},{"number":143,"text":"إِنِّى لَكُمْ رَسُولٌ أَمِينٌۭ","sajda":false},{"number":144,"text":"فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ","sajda":false},{"number":145,"text":"وَمَآ أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَجْرٍ ۖ إِنْ أَجْرِىَ إِلَّا عَلَىٰ رَبِّ ٱلْعَٰلَمِينَ","sajda":false},{"number":146,"text":"أَتُتْرَكُونَ فِى مَا هَٰهُنَآ ءَامِنِينَ","sajda":false},{"number":147,"text":"فِى جَنَّٰتٍۢ وَعُيُونٍۢ","sajda":false},{"number":148,"text":"وَزُرُوعٍۢ وَنَخْلٍۢ طَلْعُهَا هَضِيمٌۭ","sajda":false},{"number":149,"text":"وَتَنْحِتُونَ مِنَ ٱلْجِبَالِ بُيُوتًۭا فَٰرِهِينَ","sajda":false},{"number":150,"text":"فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ","sajda":false},{"number":151,"text":"وَلَا تُطِيعُوٓا۟ أَمْرَ ٱلْمُسْرِفِينَ","sajda":false},{"number":152,"text":"ٱلَّذِينَ يُفْسِدُونَ فِى ٱلْأَرْضِ وَلَا يُصْلِحُونَ","sajda":false},{"number":153,"text":"قَالُوٓا۟ إِنَّمَآ أَنتَ مِنَ ٱلْمُسَحَّرِينَ","sajda":false},{"number":154,"text":"مَآ أَنتَ إِلَّا بَشَرٌۭ مِّثْلُنَا فَأْتِ بِـَٔايَةٍ إِن كُنتَ مِنَ ٱلصَّٰدِقِينَ","sajda":false},{"number":155,"text":"قَالَ هَٰذِهِۦ نَاقَةٌۭ لَّهَا شِرْبٌۭ وَلَكُمْ شِرْبُ يَوْمٍۢ مَّعْلُومٍۢ","sajda":false},{"number":156,"text":"وَلَا تَمَسُّوهَا بِسُوٓءٍۢ فَيَأْخُذَكُمْ عَذَابُ يَوْمٍ عَظِيمٍۢ","sajda":false},{"number":157,"text":"فَعَقَرُوهَا فَأَصْبَحُوا۟ نَٰدِمِينَ","sajda":false},{"number":158,"text":"فَأَخَذَهُمُ ٱلْعَذَابُ ۗ إِنَّ فِى ذَٰلِكَ لَءَايَةًۭ ۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ","sajda":false},{"number":159,"text":"وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ","sajda":false}]}],"juz":19}
