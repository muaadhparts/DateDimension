{"page":450,"blocks":[{"surah":37,"name":"سُورَةُ الصَّافَّاتِ","englishName":"As-Saaffaat","basmala":false,"juz":23,"verses":[{"number":103,"text":"فَلَمَّآ أَسْلَمَا وَتَلَّهُۥ لِلْجَبِينِ","sajda":false},{"number":104,"text":"وَنَٰدَيْنَٰهُ أَن يَٰٓإِبْرَٰهِيمُ","sajda":false},{"number":105,"text":"قَدْ صَدَّقْتَ ٱلرُّءْيَآ ۚ إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ","sajda":false},{"number":106,"text":"إِنَّ هَٰذَا لَهُوَ ٱلْبَلَٰٓؤُا۟ ٱلْمُبِينُ","sajda":false},{"number":107,"text":"وَفَدَيْنَٰهُ بِذِبْحٍ عَظِيمٍۢ","sajda":false},{"number":108,"text":"وَتَرَكْنَا عَلَيْهِ فِى ٱلْءَاخِرِينَ","sajda":false},{"number":109,"text":"سَلَٰمٌ عَلَىٰٓ إِبْرَٰهِيمَ","sajda":false},{"number":110,"text":"كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ","sajda":false},{"number":111,"text":"إِنَّهُۥ مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ","sajda":false},{"number":112,"text":"وَبَشَّرْنَٰهُ بِإِسْحَٰقَ نَبِيًّۭا مِّنَ ٱلصَّٰلِحِينَ","sajda":false},{"number":113,"text":"وَبَٰرَكْنَا عَلَيْهِ وَعَلَىٰٓ إِسْحَٰقَ ۚ وَمِن ذُرِّيَّتِهِمَا مُحْسِنٌۭ وَظَالِمٌۭ لِّنَفْسِهِۦ مُبِينٌۭ","sajda":false},{"number":114,"text":"وَلَقَدْ مَنَنَّا عَلَىٰ مُوسَىٰ وَهَٰرُونَ","sajda":false},{"number":115,"text":"وَنَجَّيْنَٰهُمَا وَقَوْمَهُمَا مِنَ ٱلْكَرْبِ ٱلْعَظِيمِ","sajda":false},{"number":116,"text":"وَنَصَرْنَٰهُمْ فَكَانُوا۟ هُمُ ٱلْغَٰلِبِينَ","sajda":false},{"number":117,"text":"وَءَاتَيْنَٰهُمَا ٱلْكِتَٰبَ ٱلْمُسْتَبِينَ","sajda":false},{"number":118,"text":"وَهَدَيْنَٰهُمَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ","sajda":false},{"number":119,"text":"وَتَرَكْنَا عَلَيْهِمَا فِى ٱلْءَاخِرِينَ","sajda":false},{"number":120,"text":"سَلَٰمٌ عَلَىٰ مُوسَىٰ وَهَٰرُونَ","sajda":false},{"number":121,"text":"إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ","sajda":false},{"number":122,"text":"إِنَّهُمَا مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ","sajda":false},{"number":123,"text":"وَإِنَّ إِلْيَاسَ لَمِنَ ٱلْمُرْسَلِينَ","sajda":false},{"number":124,"text":"إِذْ قَالَ لِقَوْمِهِۦٓ أَلَا تَتَّقُونَ","sajda":false},{"number":125,"text":"أَتَدْعُونَ بَعْلًۭا وَتَذَرُونَ أَحْسَنَ ٱلْخَٰلِقِينَ","sajda":false},{"number":126,"text":"ٱللَّهَ رَبَّكُمْ وَرَبَّ ءَابَآئِكُمُ ٱلْأَوَّلِينَ","sajda":false}]}],"juz":23}
