{"page":448,"blocks":[{"surah":37,"name":"سُورَةُ الصَّافَّاتِ","englishName":"As-Saaffaat","basmala":false,"juz":23,"verses":[{"number":52,"text":"يَقُولُ أَءِنَّكَ لَمِنَ ٱلْمُصَدِّقِينَ","sajda":false},{"number":53,"text":"أَءِذَا مِتْنَا وَكُنَّا تُرَابًۭا وَعِظَٰمًا أَءِنَّا لَمَدِينُونَ","sajda":false},{"number":54,"text":"قَالَ هَلْ أَنتُم مُّطَّلِعُونَ","sajda":false},{"number":55,"text":"فَٱطَّلَعَ فَرَءَاهُ فِى سَوَآءِ ٱلْجَحِيمِ","sajda":false},{"number":56,"text":"قَالَ تَٱللَّهِ إِن كِدتَّ لَتُرْدِينِ","sajda":false},{"number":57,"text":"وَلَوْلَا نِعْمَةُ رَبِّى لَكُنتُ مِنَ ٱلْمُحْضَرِينَ","sajda":false},{"number":58,"text":"أَفَمَا نَحْنُ بِمَيِّتِينَ","sajda":false},{"number":59,"text":"إِلَّا مَوْتَتَنَا ٱلْأُولَىٰ وَمَا نَحْنُ بِمُعَذَّبِينَ","sajda":false},{"number":60,"text":"إِنَّ هَٰذَا لَهُوَ ٱلْفَوْزُ ٱلْعَظِيمُ","sajda":false},{"number":61,"text":"لِمِثْلِ هَٰذَا فَلْيَعْمَلِ ٱلْعَٰمِلُونَ","sajda":false},{"number":62,"text":"أَذَٰلِكَ خَيْرٌۭ نُّزُلًا أَمْ شَجَرَةُ ٱلزَّقُّومِ","sajda":false},{"number":63,"text":"إِنَّا جَعَلْنَٰهَا فِتْنَةًۭ لِّلظَّٰلِمِينَ","sajda":false},{"number":64,"text":"إِنَّهَا شَجَرَةٌۭ تَخْرُجُ فِىٓ أَصْلِ ٱلْجَحِيمِ","sajda":false},{"number":65,"text":"طَلْعُهَا كَأَنَّهُۥ رُءُوسُ ٱلشَّيَٰطِينِ","sajda":false},{"number":66,"text":"فَإِنَّهُمْ لَءَاكِلُونَ مِنْهَا فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ","sajda":false},{"number":67,"text":"ثُمَّ إِنَّ لَهُمْ عَلَيْهَا لَشَوْبًۭا مِّنْ حَمِيمٍۢ","sajda":false},{"number":68,"text":"ثُمَّ إِنَّ مَرْجِعَهُمْ لَإِلَى ٱلْجَحِيمِ","sajda":false},{"number":69,"text":"إِنَّهُمْ أَلْفَوْا۟ ءَابَآءَهُمْ ضَآلِّينَ","sajda":false},{"number":70,"text":"فَهُمْ عَلَىٰٓ ءَاثَٰرِهِمْ يُهْرَعُونَ","sajda":false},{"number":71,"text":"وَلَقَدْ ضَلَّ قَبْلَهُمْ أَكْثَرُ ٱلْأَوَّلِينَ","sajda":false},{"number":72,"text":"وَلَقَدْ أَرْسَلْنَا فِيهِم مُّنذِرِينَ","sajda":false},{"number":73,"text":"فَٱنظُرْ كَيْفَ كَانَ عَٰقِبَةُ ٱلْمُنذَرِينَ","sajda":false},{"number":74,"text":"إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ","sajda":false},{"number":75,"text":"وَلَقَدْ نَادَىٰنَا نُوحٌۭ فَلَنِعْمَ ٱلْمُجِيبُونَ","sajda":false},{"number":76,"text":"وَنَجَّيْنَٰهُ وَأَهْلَهُۥ مِنَ ٱلْكَرْبِ ٱلْعَظِيمِ","sajda":false}]}],"juz":23}
