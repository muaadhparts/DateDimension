{"page":568,"blocks":[{"surah":69,"name":"سُورَةُ الحَاقَّةِ","englishName":"Al-Haaqqa","basmala":false,"juz":29,"verses":[{"number":35,"text":"فَلَيْسَ لَهُ ٱلْيَوْمَ هَٰهُنَا حَمِيمٌۭ","sajda":false},{"number":36,"text":"وَلَا طَعَامٌ إِلَّا مِنْ غِسْلِينٍۢ","sajda":false},{"number":37,"text":"لَّا يَأْكُلُهُۥٓ إِلَّا ٱلْخَٰطِـُٔونَ","sajda":false},{"number":38,"text":"فَلَآ أُقْسِمُ بِمَا تُبْصِرُونَ","sajda":false},{"number":39,"text":"وَمَا لَا تُبْصِرُونَ","sajda":false},{"number":40,"text":"إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ","sajda":false},{"number":41,"text":"وَمَا هُوَ بِقَوْلِ شَاعِرٍۢ ۚ قَلِيلًۭا مَّا تُؤْمِنُونَ","sajda":false},{"number":42,"text":"وَلَا بِقَوْلِ كَاهِنٍۢ ۚ قَلِيلًۭا مَّا تَذَكَّرُونَ","sajda":false},{"number":43,"text":"تَنزِيلٌۭ مِّن رَّبِّ ٱلْعَٰلَمِينَ","sajda":false},{"number":44,"text":"وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ ٱلْأَقَاوِيلِ","sajda":false},{"number":45,"text":"لَأَخَذْنَا مِنْهُ بِٱلْيَمِينِ","sajda":false},{"number":46,"text":"ثُمَّ لَقَطَعْنَا مِنْهُ ٱلْوَتِينَ","sajda":false},{"number":47,"text":"فَمَا مِنكُم مِّنْ أَحَدٍ عَنْهُ حَٰجِزِينَ","sajda":false},{"number":48,"text":"وَإِنَّهُۥ لَتَذْكِرَةٌۭ لِّلْمُتَّقِينَ","sajda":false},{"number":49,"text":"وَإِنَّا لَنَعْلَمُ أَنَّ مِنكُم مُّكَذِّبِينَ","sajda":false},{"number":50,"text":"وَإِنَّهُۥ لَحَسْرَةٌ عَلَى ٱلْكَٰفِرِينَ","sajda":false},{"number":51,"text":"وَإِنَّهُۥ لَحَقُّ ٱلْيَقِينِ","sajda":false},{"number":52,"text":"فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ","sajda":false}]},{"surah":70,"name":"سُورَةُ المَعَارِجِ","englishName":"Al-Ma'aarij","basmala":true,"juz":29,"verses":[{"number":1,"text":"سَأَلَ سَآئِلٌۢ بِعَذَابٍۢ وَاقِعٍۢ","sajda":false},{"number":2,"text":"لِّلْكَٰفِرِينَ لَيْسَ لَهُۥ دَافِعٌۭ","sajda":false},{"number":3,"text":"مِّنَ ٱللَّهِ ذِى ٱلْمَعَارِجِ","sajda":false},{"number":4,"text":"تَعْرُجُ ٱلْمَلَٰٓئِكَةُ وَٱلرُّوحُ إِلَيْهِ فِى يَوْمٍۢ كَانَ مِقْدَارُهُۥ خَمْسِينَ أَلْفَ سَنَةٍۢ","sajda":false},{"number":5,"text":"فَٱصْبِرْ صَبْرًۭا جَمِيلًا","sajda":false},{"number":6,"text":"إِنَّهُمْ يَرَوْنَهُۥ بَعِيدًۭا","sajda":false},{"number":7,"text":"وَنَرَىٰهُ قَرِيبًۭا","sajda":false},{"number":8,"text":"يَوْمَ تَكُونُ ٱلسَّمَآءُ كَٱلْمُهْلِ","sajda":false},{"number":9,"text":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ","sajda":false},{"number":10,"text":"وَلَا يَسْـَٔلُ حَمِيمٌ حَمِيمًۭا","sajda":false}]}],"juz":29}
