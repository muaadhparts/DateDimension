{"page":603,"blocks":[{"surah":109,"name":"سُورَةُ الكَافِرُونَ","englishName":"Al-Kaafiroon","basmala":true,"juz":30,"verses":[{"number":1,"text":"قُلْ يَٰٓأَيُّهَا ٱلْكَٰفِرُونَ","sajda":false},{"number":2,"text":"لَآ أَعْبُدُ مَا تَعْبُدُونَ","sajda":false},{"number":3,"text":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","sajda":false},{"number":4,"text":"وَلَآ أَنَا۠ عَابِدٌۭ مَّا عَبَدتُّمْ","sajda":false},{"number":5,"text":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","sajda":false},{"number":6,"text":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ","sajda":false}]},{"surah":110,"name":"سُورَةُ النَّصۡرِ","englishName":"An-Nasr","basmala":true,"juz":30,"verses":[{"number":1,"text":"إِذَا جَآءَ نَصْرُ ٱللَّهِ وَٱلْفَتْحُ","sajda":false},{"number":2,"text":"وَرَأَيْتَ ٱلنَّاسَ يَدْخُلُونَ فِى دِينِ ٱللَّهِ أَفْوَاجًۭا","sajda":false},{"number":3,"text":"فَسَبِّحْ بِحَمْدِ رَبِّكَ وَٱسْتَغْفِرْهُ ۚ إِنَّهُۥ كَانَ تَوَّابًۢا","sajda":false}]},{"surah":111,"name":"سُورَةُ المَسَدِ","englishName":"Al-Masad","basmala":true,"juz":30,"verses":[{"number":1,"text":"تَبَّتْ يَدَآ أَبِى لَهَبٍۢ وَتَبَّ","sajda":false},{"number":2,"text":"مَآ أَغْنَىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَ","sajda":false},{"number":3,"text":"سَيَصْلَىٰ نَارًۭا ذَاتَ لَهَبٍۢ","sajda":false},{"number":4,"text":"وَٱمْرَأَتُهُۥ حَمَّالَةَ ٱلْحَطَبِ","sajda":false},{"number":5,"text":"فِى جِيدِهَا حَبْلٌۭ مِّن مَّسَدٍۭ","sajda":false}]}],"juz":30}
