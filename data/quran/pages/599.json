{"page":599,"blocks":[{"surah":98,"name":"سُورَةُ البَيِّنَةِ","englishName":"Al-Bayyina","basmala":false,"juz":30,"verses":[{"number":8,"text":"جَزَآؤُهُمْ عِندَ رَبِّهِمْ جَنَّٰتُ عَدْنٍۢ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ خَٰلِدِينَ فِيهَآ أَبَدًۭا ۖ رَّضِىَ ٱللَّهُ عَنْهُمْ وَرَضُوا۟ عَنْهُ ۚ ذَٰلِكَ لِمَنْ خَشِىَ رَبَّهُۥ","sajda":false}]},{"surah":99,"name":"سُورَةُ الزَّلۡزَلَةِ","englishName":"Az-Zalzala","basmala":true,"juz":30,"verses":[{"number":1,"text":"إِذَا زُلْزِلَتِ ٱلْأَرْضُ زِلْزَالَهَا","sajda":false},{"number":2,"text":"وَأَخْرَجَتِ ٱلْأَرْضُ أَثْقَالَهَا","sajda":false},{"number":3,"text":"وَقَالَ ٱلْإِنسَٰنُ مَا لَهَا","sajda":false},{"number":4,"text":"يَوْمَئِذٍۢ تُحَدِّثُ أَخْبَارَهَا","sajda":false},{"number":5,"text":"بِأَنَّ رَبَّكَ أَوْحَىٰ لَهَا","sajda":false},{"number":6,"text":"يَوْمَئِذٍۢ يَصْدُرُ ٱلنَّاسُ أَشْتَاتًۭا لِّيُرَوْا۟ أَعْمَٰلَهُمْ","sajda":false},{"number":7,"text":"فَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًۭا يَرَهُۥ","sajda":false},{"number":8,"text":"وَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍۢ شَرًّۭا يَرَهُۥ","sajda":false}]},{"surah":100,"name":"سُورَةُ العَادِيَاتِ","englishName":"Al-Aadiyaat","basmala":true,"juz":30,"verses":[{"number":1,"text":"وَٱلْعَٰدِيَٰتِ ضَبْحًۭا","sajda":false},{"number":2,"text":"فَٱلْمُورِيَٰتِ قَدْحًۭا","sajda":false},{"number":3,"text":"فَٱلْمُغِيرَٰتِ صُبْحًۭا","sajda":false},{"number":4,"text":"فَأَثَرْنَ بِهِۦ نَقْعًۭا","sajda":false},{"number":5,"text":"فَوَسَطْنَ بِهِۦ جَمْعًا","sajda":false},{"number":6,"text":"إِنَّ ٱلْإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٌۭ","sajda":false},{"number":7,"text":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌۭ","sajda":false},{"number":8,"text":"وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ","sajda":false},{"number":9,"text":"۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ","sajda":false}]}],"juz":30}
