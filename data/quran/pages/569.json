{"page":569,"blocks":[{"surah":70,"name":"سُورَةُ المَعَارِجِ","englishName":"Al-Ma'aarij","basmala":false,"juz":29,"verses":[{"number":11,"text":"يُبَصَّرُونَهُمْ ۚ يَوَدُّ ٱلْمُجْرِمُ لَوْ يَفْتَدِى مِنْ عَذَابِ يَوْمِئِذٍۭ بِبَنِيهِ","sajda":false},{"number":12,"text":"وَصَٰحِبَتِهِۦ وَأَخِيهِ","sajda":false},{"number":13,"text":"وَفَصِيلَتِهِ ٱلَّتِى تُـْٔوِيهِ","sajda":false},{"number":14,"text":"وَمَن فِى ٱلْأَرْضِ جَمِيعًۭا ثُمَّ يُنجِيهِ","sajda":false},{"number":15,"text":"كَلَّآ ۖ إِنَّهَا لَظَىٰ","sajda":false},{"number":16,"text":"نَزَّاعَةًۭ لِّلشَّوَىٰ","sajda":false},{"number":17,"text":"تَدْعُوا۟ مَنْ أَدْبَرَ وَتَوَلَّىٰ","sajda":false},{"number":18,"text":"وَجَمَعَ فَأَوْعَىٰٓ","sajda":false},{"number":19,"text":"۞ إِنَّ ٱلْإِنسَٰنَ خُلِقَ هَلُوعًا","sajda":false},{"number":20,"text":"إِذَا مَسَّهُ ٱلشَّرُّ جَزُوعًۭا","sajda":false},{"number":21,"text":"وَإِذَا مَسَّهُ ٱلْخَيْرُ مَنُوعًا","sajda":false},{"number":22,"text":"إِلَّا ٱلْمُصَلِّينَ","sajda":false},{"number":23,"text":"ٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ دَآئِمُونَ","sajda":false},{"number":24,"text":"وَٱلَّذِينَ فِىٓ أَمْوَٰلِهِمْ حَقٌّۭ مَّعْلُومٌۭ","sajda":false},{"number":25,"text":"لِّلسَّآئِلِ وَٱلْمَحْرُومِ","sajda":false},{"number":26,"text":"وَٱلَّذِينَ يُصَدِّقُونَ بِيَوْمِ ٱلدِّينِ","sajda":false},{"number":27,"text":"وَٱلَّذِينَ هُم مِّنْ عَذَابِ رَبِّهِم مُّشْفِقُونَ","sajda":false},{"number":28,"text":"إِنَّ عَذَابَ رَبِّهِمْ غَيْرُ مَأْمُونٍۢ","sajda":false},{"number":29,"text":"وَٱلَّذِينَ هُمْ لِفُرُوجِهِمْ حَٰفِظُونَ","sajda":false},{"number":30,"text":"إِلَّا عَلَىٰٓ أَزْوَٰجِهِمْ أَوْ مَا مَلَكَتْ أَيْمَٰنُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَ","sajda":false},{"number":31,"text":"فَمَنِ ٱبْتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُو۟لَٰٓئِكَ هُمُ ٱلْعَادُونَ","sajda":false},{"number":32,"text":"وَٱلَّذِينَ هُمْ لِأَمَٰنَٰتِهِمْ وَعَهْدِهِمْ رَٰعُونَ","sajda":false},{"number":33,"text":"وَٱلَّذِينَ هُم بِشَهَٰدَٰتِهِمْ قَآئِمُونَ","sajda":false},{"number":34,"text":"وَٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ يُحَافِظُونَ","sajda":false},{"number":35,"text":"أُو۟لَٰٓئِكَ فِى جَنَّٰتٍۢ مُّكْرَمُونَ","sajda":false},{"number":36,"text":"فَمَالِ ٱلَّذِينَ كَفَرُوا۟ قِبَلَكَ مُهْطِعِينَ","sajda":false},{"number":37,"text":"عَنِ ٱلْيَمِينِ وَعَنِ ٱلشِّمَالِ عِزِينَ","sajda":false},{"number":38,"text":"أَيَطْمَعُ كُلُّ ٱمْرِئٍۢ مِّنْهُمْ أَن يُدْخَلَ جَنَّةَ نَعِيمٍۢ","sajda":false},{"number":39,"text":"كَلَّآ ۖ إِنَّا خَلَقْنَٰهُم مِّمَّا يَعْلَمُونَ","sajda":false}]}],"juz":29}
