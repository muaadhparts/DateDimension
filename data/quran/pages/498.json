{"page":498,"blocks":[{"surah":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan","basmala":false,"juz":25,"verses":[{"number":40,"text":"إِنَّ يَوْمَ ٱلْفَصْلِ مِيقَٰتُهُمْ أَجْمَعِينَ","sajda":false},{"number":41,"text":"يَوْمَ لَا يُغْنِى مَوْلًى عَن مَّوْلًۭى شَيْـًۭٔا وَلَا هُمْ يُنصَرُونَ","sajda":false},{"number":42,"text":"إِلَّا مَن رَّحِمَ ٱللَّهُ ۚ إِنَّهُۥ هُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ","sajda":false},{"number":43,"text":"إِنَّ شَجَرَتَ ٱلزَّقُّومِ","sajda":false},{"number":44,"text":"طَعَامُ ٱلْأَثِيمِ","sajda":false},{"number":45,"text":"كَٱلْمُهْلِ يَغْلِى فِى ٱلْبُطُونِ","sajda":false},{"number":46,"text":"كَغَلْىِ ٱلْحَمِيمِ","sajda":false},{"number":47,"text":"خُذُوهُ فَٱعْتِلُوهُ إِلَىٰ سَوَآءِ ٱلْجَحِيمِ","sajda":false},{"number":48,"text":"ثُمَّ صُبُّوا۟ فَوْقَ رَأْسِهِۦ مِنْ عَذَابِ ٱلْحَمِيمِ","sajda":false},{"number":49,"text":"ذُقْ إِنَّكَ أَنتَ ٱلْعَزِيزُ ٱلْكَرِيمُ","sajda":false},{"number":50,"text":"إِنَّ هَٰذَا مَا كُنتُم بِهِۦ تَمْتَرُونَ","sajda":false},{"number":51,"text":"إِنَّ ٱلْمُتَّقِينَ فِى مَقَامٍ أَمِينٍۢ","sajda":false},{"number":52,"text":"فِى جَنَّٰتٍۢ وَعُيُونٍۢ","sajda":false},{"number":53,"text":"يَلْبَسُونَ مِن سُندُسٍۢ وَإِسْتَبْرَقٍۢ مُّتَقَٰبِلِينَ","sajda":false},{"number":54,"text":"كَذَٰلِكَ وَزَوَّجْنَٰهُم بِحُورٍ عِينٍۢ","sajda":false},{"number":55,"text":"يَدْعُونَ فِيهَا بِكُلِّ فَٰكِهَةٍ ءَامِنِينَ","sajda":false},{"number":56,"text":"لَا يَذُوقُونَ فِيهَا ٱلْمَوْتَ إِلَّا ٱلْمَوْتَةَ ٱلْأُولَىٰ ۖ وَوَقَىٰهُمْ عَذَابَ ٱلْجَحِيمِ","sajda":false},{"number":57,"text":"فَضْلًۭا مِّن رَّبِّكَ ۚ ذَٰلِكَ هُوَ ٱلْفَوْزُ ٱلْعَظِيمُ","sajda":false},{"number":58,"text":"فَإِنَّمَا يَسَّرْنَٰهُ بِلِسَانِكَ لَعَلَّهُمْ يَتَذَكَّرُونَ","sajda":false},{"number":59,"text":"فَٱرْتَقِبْ إِنَّهُم مُّرْتَقِبُونَ","sajda":false}]}],"juz":25}
