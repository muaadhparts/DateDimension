{"page":577,"blocks":[{"surah":74,"name":"سُورَةُ المُدَّثِّرِ","englishName":"Al-Muddaththir","basmala":false,"juz":29,"verses":[{"number":48,"text":"فَمَا تَنفَعُهُمْ شَفَٰعَةُ ٱلشَّٰفِعِينَ","sajda":false},{"number":49,"text":"فَمَا لَهُمْ عَنِ ٱلتَّذْكِرَةِ مُعْرِضِينَ","sajda":false},{"number":50,"text":"كَأَنَّهُمْ حُمُرٌۭ مُّسْتَنفِرَةٌۭ","sajda":false},{"number":51,"text":"فَرَّتْ مِن قَسْوَرَةٍۭ","sajda":false},{"number":52,"text":"بَلْ يُرِيدُ كُلُّ ٱمْرِئٍۢ مِّنْهُمْ أَن يُؤْتَىٰ صُحُفًۭا مُّنَشَّرَةًۭ","sajda":false},{"number":53,"text":"كَلَّا ۖ بَل لَّا يَخَافُونَ ٱلْءَاخِرَةَ","sajda":false},{"number":54,"text":"كَلَّآ إِنَّهُۥ تَذْكِرَةٌۭ","sajda":false},{"number":55,"text":"فَمَن شَآءَ ذَكَرَهُۥ","sajda":false},{"number":56,"text":"وَمَا يَذْكُرُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ ۚ هُوَ أَهْلُ ٱلتَّقْوَىٰ وَأَهْلُ ٱلْمَغْفِرَةِ","sajda":false}]},{"surah":75,"name":"سُورَةُ القِيَامَةِ","englishName":"Al-Qiyaama","basmala":true,"juz":29,"verses":[{"number":1,"text":"لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَٰمَةِ","sajda":false},{"number":2,"text":"وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ","sajda":false},{"number":3,"text":"أَيَحْسَبُ ٱلْإِنسَٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ","sajda":false},{"number":4,"text":"بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ","sajda":false},{"number":5,"text":"بَلْ يُرِيدُ ٱلْإِنسَٰنُ لِيَفْجُرَ أَمَامَهُۥ","sajda":false},{"number":6,"text":"يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَٰمَةِ","sajda":false},{"number":7,"text":"فَإِذَا بَرِقَ ٱلْبَصَرُ","sajda":false},{"number":8,"text":"وَخَسَفَ ٱلْقَمَرُ","sajda":false},{"number":9,"text":"وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ","sajda":false},{"number":10,"text":"يَقُولُ ٱلْإِنسَٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ","sajda":false},{"number":11,"text":"كَلَّا لَا وَزَرَ","sajda":false},{"number":12,"text":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ","sajda":false},{"number":13,"text":"يُنَبَّؤُا۟ ٱلْإِنسَٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ","sajda":false},{"number":14,"text":"بَلِ ٱلْإِنسَٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌۭ","sajda":false},{"number":15,"text":"وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ","sajda":false},{"number":16,"text":"لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ","sajda":false},{"number":17,"text":"إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ","sajda":false},{"number":18,"text":"فَإِذَا قَرَأْنَٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ","sajda":false},{"number":19,"text":"ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ","sajda":false}]}],"juz":29}
