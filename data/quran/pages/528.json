{"page":528,"blocks":[{"surah":53,"name":"سُورَةُ النَّجۡمِ","englishName":"An-Najm","basmala":false,"juz":27,"verses":[{"number":45,"text":"وَأَنَّهُۥ خَلَقَ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰ","sajda":false},{"number":46,"text":"مِن نُّطْفَةٍ إِذَا تُمْنَىٰ","sajda":false},{"number":47,"text":"وَأَنَّ عَلَيْهِ ٱلنَّشْأَةَ ٱلْأُخْرَىٰ","sajda":false},{"number":48,"text":"وَأَنَّهُۥ هُوَ أَغْنَىٰ وَأَقْنَىٰ","sajda":false},{"number":49,"text":"وَأَنَّهُۥ هُوَ رَبُّ ٱلشِّعْرَىٰ","sajda":false},{"number":50,"text":"وَأَنَّهُۥٓ أَهْلَكَ عَادًا ٱلْأُولَىٰ","sajda":false},{"number":51,"text":"وَثَمُودَا۟ فَمَآ أَبْقَىٰ","sajda":false},{"number":52,"text":"وَقَوْمَ نُوحٍۢ مِّن قَبْلُ ۖ إِنَّهُمْ كَانُوا۟ هُمْ أَظْلَمَ وَأَطْغَىٰ","sajda":false},{"number":53,"text":"وَٱلْمُؤْتَفِكَةَ أَهْوَىٰ","sajda":false},{"number":54,"text":"فَغَشَّىٰهَا مَا غَشَّىٰ","sajda":false},{"number":55,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكَ تَتَمَارَىٰ","sajda":false},{"number":56,"text":"هَٰذَا نَذِيرٌۭ مِّنَ ٱلنُّذُرِ ٱلْأُولَىٰٓ","sajda":false},{"number":57,"text":"أَزِفَتِ ٱلْءَازِفَةُ","sajda":false},{"number":58,"text":"لَيْسَ لَهَا مِن دُونِ ٱللَّهِ كَاشِفَةٌ","sajda":false},{"number":59,"text":"أَفَمِنْ هَٰذَا ٱلْحَدِيثِ تَعْجَبُونَ","sajda":false},{"number":60,"text":"وَتَضْحَكُونَ وَلَا تَبْكُونَ","sajda":false},{"number":61,"text":"وَأَنتُمْ سَٰمِدُونَ","sajda":false},{"number":62,"text":"فَٱسْجُدُوا۟ لِلَّهِ وَٱعْبُدُوا۟ ۩","sajda":true}]},{"surah":54,"name":"سُورَةُ القَمَرِ","englishName":"Al-Qamar","basmala":true,"juz":27,"verses":[{"number":1,"text":"ٱقْتَرَبَتِ ٱلسَّاعَةُ وَٱنشَقَّ ٱلْقَمَرُ","sajda":false},{"number":2,"text":"وَإِن يَرَوْا۟ ءَايَةًۭ يُعْرِضُوا۟ وَيَقُولُوا۟ سِحْرٌۭ مُّسْتَمِرٌّۭ","sajda":false},{"number":3,"text":"وَكَذَّبُوا۟ وَٱتَّبَعُوٓا۟ أَهْوَآءَهُمْ ۚ وَكُلُّ أَمْرٍۢ مُّسْتَقِرٌّۭ","sajda":false},{"number":4,"text":"وَلَقَدْ جَآءَهُم مِّنَ ٱلْأَنۢبَآءِ مَا فِيهِ مُزْدَجَرٌ","sajda":false},{"number":5,"text":"حِكْمَةٌۢ بَٰلِغَةٌۭ ۖ فَمَا تُغْنِ ٱلنُّذُرُ","sajda":false},{"number":6,"text":"فَتَوَلَّ عَنْهُمْ ۘ يَوْمَ يَدْعُ ٱلدَّاعِ إِلَىٰ شَىْءٍۢ نُّكُرٍ","sajda":false}]}],"juz":27}
