{"page":586,"blocks":[{"surah":81,"name":"سُورَةُ التَّكۡوِيرِ","englishName":"At-Takwir","basmala":true,"juz":30,"verses":[{"number":1,"text":"إِذَا ٱلشَّمْسُ كُوِّرَتْ","sajda":false},{"number":2,"text":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ","sajda":false},{"number":3,"text":"وَإِذَا ٱلْجِبَالُ سُيِّرَتْ","sajda":false},{"number":4,"text":"وَإِذَا ٱلْعِشَارُ عُطِّلَتْ","sajda":false},{"number":5,"text":"وَإِذَا ٱلْوُحُوشُ حُشِرَتْ","sajda":false},{"number":6,"text":"وَإِذَا ٱلْبِحَارُ سُجِّرَتْ","sajda":false},{"number":7,"text":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ","sajda":false},{"number":8,"text":"وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ","sajda":false},{"number":9,"text":"بِأَىِّ ذَنۢبٍۢ قُتِلَتْ","sajda":false},{"number":10,"text":"وَإِذَا ٱلصُّحُفُ نُشِرَتْ","sajda":false},{"number":11,"text":"وَإِذَا ٱلسَّمَآءُ كُشِطَتْ","sajda":false},{"number":12,"text":"وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ","sajda":false},{"number":13,"text":"وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ","sajda":false},{"number":14,"text":"عَلِمَتْ نَفْسٌۭ مَّآ أَحْضَرَتْ","sajda":false},{"number":15,"text":"فَلَآ أُقْسِمُ بِٱلْخُنَّسِ","sajda":false},{"number":16,"text":"ٱلْجَوَارِ ٱلْكُنَّسِ","sajda":false},{"number":17,"text":"وَٱلَّيْلِ إِذَا عَسْعَسَ","sajda":false},{"number":18,"text":"وَٱلصُّبْحِ إِذَا تَنَفَّسَ","sajda":false},{"number":19,"text":"إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ","sajda":false},{"number":20,"text":"ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍۢ","sajda":false},{"number":21,"text":"مُّطَاعٍۢ ثَمَّ أَمِينٍۢ","sajda":false},{"number":22,"text":"وَمَا صَاحِبُكُم بِمَجْنُونٍۢ","sajda":false},{"number":23,"text":"وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ","sajda":false},{"number":24,"text":"وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍۢ","sajda":false},{"number":25,"text":"وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍۢ رَّجِيمٍۢ","sajda":false},{"number":26,"text":"فَأَيْنَ تَذْهَبُونَ","sajda":false},{"number":27,"text":"إِنْ هُوَ إِلَّا ذِكْرٌۭ لِّلْعَٰلَمِينَ","sajda":false},{"number":28,"text":"لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ","sa