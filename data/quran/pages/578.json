{"page":578,"blocks":[{"surah":75,"name":"سُورَةُ القِيَامَةِ","englishName":"Al-Qiyaama","basmala":false,"juz":29,"verses":[{"number":20,"text":"كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ","sajda":false},{"number":21,"text":"وَتَذَرُونَ ٱلْءَاخِرَةَ","sajda":false},{"number":22,"text":"وُجُوهٌۭ يَوْمَئِذٍۢ نَّاضِرَةٌ","sajda":false},{"number":23,"text":"إِلَىٰ رَبِّهَا نَاظِرَةٌۭ","sajda":false},{"number":24,"text":"وَوُجُوهٌۭ يَوْمَئِذٍۭ بَاسِرَةٌۭ","sajda":false},{"number":25,"text":"تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌۭ","sajda":false},{"number":26,"text":"كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ","sajda":false},{"number":27,"text":"وَقِيلَ مَنْ ۜ رَاقٍۢ","sajda":false},{"number":28,"text":"وَظَنَّ أَنَّهُ ٱلْفِرَاقُ","sajda":false},{"number":29,"text":"وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ","sajda":false},{"number":30,"text":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ","sajda":false},{"number":31,"text":"فَلَا صَدَّقَ وَلَا صَلَّىٰ","sajda":false},{"number":32,"text":"وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ","sajda":false},{"number":33,"text":"ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ","sajda":false},{"number":34,"text":"أَوْلَىٰ لَكَ فَأَوْلَىٰ","sajda":false},{"number":35,"text":"ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ","sajda":false},{"number":36,"text":"أَيَحْسَبُ ٱلْإِنسَٰنُ أَن يُتْرَكَ سُدًى","sajda":false},{"number":37,"text":"أَلَمْ يَكُ نُطْفَةًۭ مِّن مَّنِىٍّۢ يُمْنَىٰ","sajda":false},{"number":38,"text":"ثُمَّ كَانَ عَلَقَةًۭ فَخَلَقَ فَسَوَّىٰ","sajda":false},{"number":39,"text":"فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ","sajda":false},{"number":40,"text":"أَلَيْسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحْۦِىَ ٱلْمَوْتَىٰ","sajda":false}]},{"surah":76,"name":"سُورَةُ الإِنسَانِ","englishName":"Al-Insaan","basmala":true,"juz":29,"verses":[{"number":1,"text":"هَلْ أَتَىٰ عَلَى ٱلْإِنسَٰنِ حِينٌۭ مِّنَ ٱلدَّهْرِ لَمْ يَكُن شَيْـًۭٔا مَّذْكُورًا","sajda":false},{"number":2,"text":"إِنَّا خَلَقْنَا ٱلْإِنسَٰنَ مِن نُّطْفَةٍ أَمْشَاجٍۢ نَّبْتَلِيهِ فَجَعَلْنَٰهُ سَمِيعًۢا بَصِيرًا","sajda":false},{"number":3,"text":"إِنَّا هَدَيْنَٰهُ ٱلسَّبِيلَ إِمَّا شَاكِرًۭا وَإِمَّا كَفُورًا","sajda":false},{"number":4,"text":"إِنَّآ أَعْتَدْنَا لِلْكَٰفِرِينَ سَلَٰسِلَا۟ وَأَغْلَٰلًۭا وَسَعِيرًا","sajda":false},{"number":5,"text":"إِنَّ ٱلْأَبْرَارَ يَشْرَبُونَ مِن كَأْسٍۢ كَانَ مِزَاجُهَا كَافُورًا","sajda":false}]}],"juz":29}
