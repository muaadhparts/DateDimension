{"page":587,"blocks":[{"surah":82,"name":"سُورَةُ الانفِطَارِ","englishName":"Al-Infitaar","basmala":true,"juz":30,"verses":[{"number":1,"text":"إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ","sajda":false},{"number":2,"text":"وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ","sajda":false},{"number":3,"text":"وَإِذَا ٱلْبِحَارُ فُجِّرَتْ","sajda":false},{"number":4,"text":"وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ","sajda":false},{"number":5,"text":"عَلِمَتْ نَفْسٌۭ مَّا قَدَّمَتْ وَأَخَّرَتْ","sajda":false},{"number":6,"text":"يَٰٓأَيُّهَا ٱلْإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ","sajda":false},{"number":7,"text":"ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ","sajda":false},{"number":8,"text":"فِىٓ أَىِّ صُورَةٍۢ مَّا شَآءَ رَكَّبَكَ","sajda":false},{"number":9,"text":"كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ","sajda":false},{"number":10,"text":"وَإِنَّ عَلَيْكُمْ لَحَٰفِظِينَ","sajda":false},{"number":11,"text":"كِرَامًۭا كَٰتِبِينَ","sajda":false},{"number":12,"text":"يَعْلَمُونَ مَا تَفْعَلُونَ","sajda":false},{"number":13,"text":"إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍۢ","sajda":false},{"number":14,"text":"وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍۢ","sajda":false},{"number":15,"text":"يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ","sajda":false},{"number":16,"text":"وَمَا هُمْ عَنْهَا بِغَآئِبِينَ","sajda":false},{"number":17,"text":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ","sajda":false},{"number":18,"text":"ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ","sajda":false},{"number":19,"text":"يَوْمَ لَا تَمْلِكُ نَفْسٌۭ لِّنَفْسٍۢ شَيْـًۭٔا ۖ وَٱلْأَمْرُ يَوْمَئِذٍۢ لِّلَّهِ","sajda":false}]},{"surah":83,"name":"سُورَةُ المُطَفِّفِينَ","englishName":"Al-Mutaffifin","basmala":true,"juz":30,"verses":[{"number":1,"text":"وَيْلٌۭ لِّلْمُطَفِّفِينَ","sajda":false},{"number":2,"text":"ٱلَّذِينَ إِذَا ٱكْتَالُوا۟ عَلَى ٱلنَّاسِ يَسْتَوْفُونَ","sajda":false},{"number":3,"text":"وَإِذَا كَالُوهُمْ أَو وَّزَنُوهُمْ يُخْسِرُونَ","sajda":false},{"number":4,"text":"أَلَا يَظُنُّ أُو۟لَٰٓئِكَ أَنَّهُم مَّبْعُوثُونَ","sajda":false},{"number":5,"text":"لِيَوْمٍ عَظِيمٍۢ","sajda":false},{"number":6,"text":"يَوْمَ يَقُومُ ٱلنَّاسُ لِرَبِّ ٱلْعَٰلَمِينَ","sajda":false}]}],"juz":30}
