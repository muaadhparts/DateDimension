{"page":372,"blocks":[{"surah":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa","basmala":false,"juz":19,"verses":[{"number":112,"text":"قَالَ وَمَا عِلْمِى بِمَا كَانُوا۟ يَعْمَلُونَ","sajda":false},{"number":113,"text":"إِنْ حِسَابُهُمْ إِلَّا عَلَىٰ رَبِّى ۖ لَوْ تَشْعُرُونَ","sajda":false},{"number":114,"text":"وَمَآ أَنَا۠ بِطَارِدِ ٱلْمُؤْمِنِينَ","sajda":false},{"number":115,"text":"إِنْ أَنَا۠ إِلَّا نَذِيرٌۭ مُّبِينٌۭ","sajda":false},{"number":116,"text":"قَالُوا۟ لَئِن لَّمْ تَنتَهِ يَٰنُوحُ لَتَكُونَنَّ مِنَ ٱلْمَرْجُومِينَ","sajda":false},{"number":117,"text":"قَالَ رَبِّ إِنَّ قَوْمِى كَذَّبُونِ","sajda":false},{"number":118,"text":"فَٱفْتَحْ بَيْنِى وَبَيْنَهُمْ فَتْحًۭا وَنَجِّنِى وَمَن مَّعِىَ مِنَ ٱلْمُؤْمِنِينَ","sajda":false},{"number":119,"text":"فَأَنجَيْنَٰهُ وَمَن مَّعَهُۥ فِى ٱلْفُلْكِ ٱلْمَشْحُونِ","sajda":false},{"number":120,"text":"ثُمَّ أَغْرَقْنَا بَعْدُ ٱلْبَاقِينَ","sajda":false},{"number":121,"text":"إِنَّ فِى ذَٰلِكَ لَءَايَةًۭ ۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ","sajda":false},{"number":122,"text":"وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ","sajda":false},{"number":123,"text":"كَذَّبَتْ عَادٌ ٱلْمُرْسَلِينَ","sajda":false},{"number":124,"text":"إِذْ قَالَ لَهُمْ أَخُوهُمْ هُودٌ أَلَا تَتَّقُونَ","sajda":false},{"number":125,"text":"إِنِّى لَكُمْ رَسُولٌ أَمِينٌۭ","sajda":false},{"number":126,"text":"فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ","sajda":false},{"number":127,"text":"وَمَآ أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَجْرٍ ۖ إِنْ أَجْرِىَ إِلَّا عَلَىٰ رَبِّ ٱلْعَٰلَمِينَ","sajda":false},{"number":128,"text":"أَتَبْنُونَ بِكُلِّ رِيعٍ ءَايَةًۭ تَعْبَثُونَ","sajda":false},{"number":129,"text":"وَتَتَّخِذُونَ مَصَانِعَ لَعَلَّكُمْ تَخْلُدُونَ","sajda":false},{"number":130,"text":"وَإِذَا بَطَشْتُم بَطَشْتُمْ جَبَّارِينَ","sajda":false},{"number":131,"text":"فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ","sajda":false},{"number":132,"text":"وَٱتَّقُوا۟ ٱلَّذِىٓ أَمَدَّكُم بِمَا تَعْلَمُونَ","sajda":false},{"number":133,"text":"أَمَدَّكُم بِأَنْعَٰمٍۢ وَبَنِينَ","sajda":false},{"number":134,"text":"وَجَنَّٰتٍۢ وَعُيُونٍ","sajda":false},{"number":135,"text":"إِنِّىٓ أَخَافُ عَلَيْكُمْ عَذَابَ يَوْمٍ عَظِيمٍۢ","sajda":false},{"number":136,"text":"قَالُوا۟ سَوَآءٌ عَلَيْنَآ أَوَعَظْتَ أَمْ لَمْ تَكُن مِّنَ ٱلْوَٰعِظِينَ","sajda":false}]}],"juz":19}
