{"page":601,"blocks":[{"surah":103,"name":"سُورَةُ العَصۡرِ","englishName":"Al-Asr","basmala":true,"juz":30,"verses":[{"number":1,"text":"وَٱلْعَصْرِ","sajda":false},{"number":2,"text":"إِنَّ ٱلْإِنسَٰنَ لَفِى خُسْرٍ","sajda":false},{"number":3,"text":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ وَتَوَاصَوْا۟ بِٱلْحَقِّ وَتَوَاصَوْا۟ بِٱلصَّبْرِ","sajda":false}]},{"surah":104,"name":"سُورَةُ الهُمَزَةِ","englishName":"Al-Humaza","basmala":true,"juz":30,"verses":[{"number":1,"text":"وَيْلٌۭ لِّكُلِّ هُمَزَةٍۢ لُّمَزَةٍ","sajda":false},{"number":2,"text":"ٱلَّذِى جَمَعَ مَالًۭا وَعَدَّدَهُۥ","sajda":false},{"number":3,"text":"يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ","sajda":false},{"number":4,"text":"كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ","sajda":false},{"number":5,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ","sajda":false},{"number":6,"text":"نَارُ ٱللَّهِ ٱلْمُوقَدَةُ","sajda":false},{"number":7,"text":"ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ","sajda":false},{"number":8,"text":"إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌۭ","sajda":false},{"number":9,"text":"فِى عَمَدٍۢ مُّمَدَّدَةٍۭ","sajda":false}]},{"surah":105,"name":"سُورَةُ الفِيلِ","englishName":"Al-Fil","basmala":true,"juz":30,"verses":[{"number":1,"text":"أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَٰبِ ٱلْفِيلِ","sajda":false},{"number":2,"text":"أَلَمْ يَجْعَلْ كَيْدَهُمْ فِى تَضْلِيلٍۢ","sajda":false},{"number":3,"text":"وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ","sajda":false},{"number":4,"text":"تَرْمِيهِم بِحِجَارَةٍۢ مِّن سِجِّيلٍۢ","sajda":false},{"number":5,"text":"فَجَعَلَهُمْ كَعَصْفٍۢ مَّأْكُولٍۭ","sajda":false}]}],"juz":30}
