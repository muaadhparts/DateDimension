{"page":371,"blocks":[{"surah":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa","basmala":false,"juz":19,"verses":[{"number":84,"text":"وَٱجْعَل لِّى لِسَانَ صِدْقٍۢ فِى ٱلْءَاخِرِينَ","sajda":false},{"number":85,"text":"وَٱجْعَلْنِى مِن وَرَثَةِ جَنَّةِ ٱلنَّعِيمِ","sajda":false},{"number":86,"text":"وَٱغْفِرْ لِأَبِىٓ إِنَّهُۥ كَانَ مِنَ ٱلضَّآلِّينَ","sajda":false},{"number":87,"text":"وَلَا تُخْزِنِى يَوْمَ يُبْعَثُونَ","sajda":false},{"number":88,"text":"يَوْمَ لَا يَنفَعُ مَالٌۭ وَلَا بَنُونَ","sajda":false},{"number":89,"text":"إِلَّا مَنْ أَتَى ٱللَّهَ بِقَلْبٍۢ سَلِيمٍۢ","sajda":false},{"number":90,"text":"وَأُزْلِفَتِ ٱلْجَنَّةُ لِلْمُتَّقِينَ","sajda":false},{"number":91,"text":"وَبُرِّزَتِ ٱلْجَحِيمُ لِلْغَاوِينَ","sajda":false},{"number":92,"text":"وَقِيلَ لَهُمْ أَيْنَ مَا كُنتُمْ تَعْبُدُونَ","sajda":false},{"number":93,"text":"مِن دُونِ ٱللَّهِ هَلْ يَنصُرُونَكُمْ أَوْ يَنتَصِرُونَ","sajda":false},{"number":94,"text":"فَكُبْكِبُوا۟ فِيهَا هُمْ وَٱلْغَاوُۥنَ","sajda":false},{"number":95,"text":"وَجُنُودُ إِبْلِيسَ أَجْمَعُونَ","sajda":false},{"number":96,"text":"قَالُوا۟ وَهُمْ فِيهَا يَخْتَصِمُونَ","sajda":false},{"number":97,"text":"تَٱللَّهِ إِن كُنَّا لَفِى ضَلَٰلٍۢ مُّبِينٍ","sajda":false},{"number":98,"text":"إِذْ نُسَوِّيكُم بِرَبِّ ٱلْعَٰلَمِينَ","sajda":false},{"number":99,"text":"وَمَآ أَضَلَّنَآ إِلَّا ٱلْمُجْرِمُونَ","sajda":false},{"number":100,"text":"فَمَا لَنَا مِن شَٰفِعِينَ","sajda":false},{"number":101,"text":"وَلَا صَدِيقٍ حَمِيمٍۢ","sajda":false},{"number":102,"text":"فَلَوْ أَنَّ لَنَا كَرَّةًۭ فَنَكُونَ مِنَ ٱلْمُؤْمِنِينَ","sajda":false},{"number":103,"text":"إِنَّ فِى ذَٰلِكَ لَءَايَةًۭ ۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ","sajda":false},{"number":104,"text":"وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ","sajda":false},{"number":105,"text":"كَذَّبَتْ قَوْمُ نُوحٍ ٱلْمُرْسَلِينَ","sajda":false},{"number":106,"text":"إِذْ قَالَ لَهُمْ أَخُوهُمْ نُوحٌ أَلَا تَتَّقُونَ","sajda":false},{"number":107,"text":"إِنِّى لَكُمْ رَسُولٌ أَمِينٌۭ","sajda":false},{"number":108,"text":"فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ","sajda":false},{"number":109,"text":"وَمَآ أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَجْرٍ ۖ إِنْ أَجْرِىَ إِلَّا عَلَىٰ رَبِّ ٱلْعَٰلَمِينَ","sajda":false},{"number":110,"text":"فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ","sajda":false},{"number":111,"text":"۞ قَالُوٓا۟ أَنُؤْمِنُ لَكَ وَٱتَّبَعَكَ ٱلْأَرْذَلُونَ","sajda":false}]}],"juz":19}
