{"page":592,"blocks":[{"surah":87,"name":"سُورَةُ الأَعۡلَىٰ","englishName":"Al-A'laa","basmala":false,"juz":30,"verses":[{"number":16,"text":"بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا","sajda":false},{"number":17,"text":"وَٱلْءَاخِرَةُ خَيْرٌۭ وَأَبْقَىٰٓ","sajda":false},{"number":18,"text":"إِنَّ هَٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ","sajda":false},{"number":19,"text":"صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ","sajda":false}]},{"surah":88,"name":"سُورَةُ الغَاشِيَةِ","englishName":"Al-Ghaashiya","basmala":true,"juz":30,"verses":[{"number":1,"text":"هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَٰشِيَةِ","sajda":false},{"number":2,"text":"وُجُوهٌۭ يَوْمَئِذٍ خَٰشِعَةٌ","sajda":false},{"number":3,"text":"عَامِلَةٌۭ نَّاصِبَةٌۭ","sajda":false},{"number":4,"text":"تَصْلَىٰ نَارًا حَامِيَةًۭ","sajda":false},{"number":5,"text":"تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍۢ","sajda":false},{"number":6,"text":"لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍۢ","sajda":false},{"number":7,"text":"لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍۢ","sajda":false},{"number":8,"text":"وُجُوهٌۭ يَوْمَئِذٍۢ نَّاعِمَةٌۭ","sajda":false},{"number":9,"text":"لِّسَعْيِهَا رَاضِيَةٌۭ","sajda":false},{"number":10,"text":"فِى جَنَّةٍ عَالِيَةٍۢ","sajda":false},{"number":11,"text":"لَّا تَسْمَعُ فِيهَا لَٰغِيَةًۭ","sajda":false},{"number":12,"text":"فِيهَا عَيْنٌۭ جَارِيَةٌۭ","sajda":false},{"number":13,"text":"فِيهَا سُرُرٌۭ مَّرْفُوعَةٌۭ","sajda":false},{"number":14,"text":"وَأَكْوَابٌۭ مَّوْضُوعَةٌۭ","sajda":false},{"number":15,"text":"وَنَمَارِقُ مَصْفُوفَةٌۭ","sajda":false},{"number":16,"text":"وَزَرَابِىُّ مَبْثُوثَةٌ","sajda":false},{"number":17,"text":"أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ","sajda":false},{"number":18,"text":"وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ","sajda":false},{"number":19,"text":"وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ","sajda":false},{"number":20,"text":"وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ","sajda":false},{"number":21,"text":"فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌۭ","sajda":false},{"number":22,"text":"لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ","sajda":false},{"number":23,"text":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ","sajda":false},{"number":24,"text":"فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ","sajda":false},{"number":25,"text":"إِنَّ إِلَيْنَآ إِيَابَهُمْ","sajda":false},{"number":26,"text":"ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم","sajda":false}]}],"juz":30}
