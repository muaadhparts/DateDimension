{"page":580,"blocks":[{"surah":76,"name":"سُورَةُ الإِنسَانِ","englishName":"Al-Insaan","basmala":false,"juz":29,"verses":[{"number":26,"text":"وَمِنَ ٱلَّيْلِ فَٱسْجُدْ لَهُۥ وَسَبِّحْهُ لَيْلًۭا طَوِيلًا","sajda":false},{"number":27,"text":"إِنَّ هَٰٓؤُلَآءِ يُحِبُّونَ ٱلْعَاجِلَةَ وَيَذَرُونَ وَرَآءَهُمْ يَوْمًۭا ثَقِيلًۭا","sajda":false},{"number":28,"text":"نَّحْنُ خَلَقْنَٰهُمْ وَشَدَدْنَآ أَسْرَهُمْ ۖ وَإِذَا شِئْنَا بَدَّلْنَآ أَمْثَٰلَهُمْ تَبْدِيلًا","sajda":false},{"number":29,"text":"إِنَّ هَٰذِهِۦ تَذْكِرَةٌۭ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ سَبِيلًۭا","sajda":false},{"number":30,"text":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ ۚ إِنَّ ٱللَّهَ كَانَ عَلِيمًا حَكِيمًۭا","sajda":false},{"number":31,"text":"يُدْخِلُ مَن يَشَآءُ فِى رَحْمَتِهِۦ ۚ وَٱلظَّٰلِمِينَ أَعَدَّ لَهُمْ عَذَابًا أَلِيمًۢا","sajda":false}]},{"surah":77,"name":"سُورَةُ المُرۡسَلَاتِ","englishName":"Al-Mursalaat","basmala":true,"juz":29,"verses":[{"number":1,"text":"وَٱلْمُرْسَلَٰتِ عُرْفًۭا","sajda":false},{"number":2,"text":"فَٱلْعَٰصِفَٰتِ عَصْفًۭا","sajda":false},{"number":3,"text":"وَٱلنَّٰشِرَٰتِ نَشْرًۭا","sajda":false},{"number":4,"text":"فَٱلْفَٰرِقَٰتِ فَرْقًۭا","sajda":false},{"number":5,"text":"فَٱلْمُلْقِيَٰتِ ذِكْرًا","sajda":false},{"number":6,"text":"عُذْرًا أَوْ نُذْرًا","sajda":false},{"number":7,"text":"إِنَّمَا تُوعَدُونَ لَوَٰقِعٌۭ","sajda":false},{"number":8,"text":"فَإِذَا ٱلنُّجُومُ طُمِسَتْ","sajda":false},{"number":9,"text":"وَإِذَا ٱلسَّمَآءُ فُرِجَتْ","sajda":false},{"number":10,"text":"وَإِذَا ٱلْجِبَالُ نُسِفَتْ","sajda":false},{"number":11,"text":"وَإِذَا ٱلرُّسُلُ أُقِّتَتْ","sajda":false},{"number":12,"text":"لِأَىِّ يَوْمٍ أُجِّلَتْ","sajda":false},{"number":13,"text":"لِيَوْمِ ٱلْفَصْلِ","sajda":false},{"number":14,"text":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ","sajda":false},{"number":15,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","sajda":false},{"number":16,"text":"أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ","sajda":false},{"number":17,"text":"ثُمَّ نُتْبِعُهُمُ ٱلْءَاخِرِينَ","sajda":false},{"number":18,"text":"كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ","sajda":false},{"number":19,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","sajda":false}]}],"juz":29}
