{"page":595,"blocks":[{"surah":91,"name":"سُورَةُ الشَّمۡسِ","englishName":"Ash-Shams","basmala":true,"juz":30,"verses":[{"number":1,"text":"وَٱلشَّمْسِ وَضُحَىٰهَا","sajda":false},{"number":2,"text":"وَٱلْقَمَرِ إِذَا تَلَىٰهَا","sajda":false},{"number":3,"text":"وَٱلنَّهَارِ إِذَا جَلَّىٰهَا","sajda":false},{"number":4,"text":"وَٱلَّيْلِ إِذَا يَغْشَىٰهَا","sajda":false},{"number":5,"text":"وَٱلسَّمَآءِ وَمَا بَنَىٰهَا","sajda":false},{"number":6,"text":"وَٱلْأَرْضِ وَمَا طَحَىٰهَا","sajda":false},{"number":7,"text":"وَنَفْسٍۢ وَمَا سَوَّىٰهَا","sajda":false},{"number":8,"text":"فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا","sajda":false},{"number":9,"text":"قَدْ أَفْلَحَ مَن زَكَّىٰهَا","sajda":false},{"number":10,"text":"وَقَدْ خَابَ مَن دَسَّىٰهَا","sajda":false},{"number":11,"text":"كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ","sajda":false},{"number":12,"text":"إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا","sajda":false},{"number":13,"text":"فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَٰهَا","sajda":false},{"number":14,"text":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا","sajda":false},{"number":15,"text":"وَلَا يَخَافُ عُقْبَٰهَا","sajda":false}]},{"surah":92,"name":"سُورَةُ اللَّيۡلِ","englishName":"Al-Lail","basmala":true,"juz":30,"verses":[{"number":1,"text":"وَٱلَّيْلِ إِذَا يَغْشَىٰ","sajda":false},{"number":2,"text":"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ","sajda":false},{"number":3,"text":"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ","sajda":false},{"number":4,"text":"إِنَّ سَعْيَكُمْ لَشَتَّىٰ","sajda":false},{"number":5,"text":"فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ","sajda":false},{"number":6,"text":"وَصَدَّقَ بِٱلْحُسْنَىٰ","sajda":false},{"number":7,"text":"فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ","sajda":false},{"number":8,"text":"وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ","sajda":false},{"number":9,"text":"وَكَذَّبَ بِٱلْحُسْنَىٰ","sajda":false},{"number":10,"text":"فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ","sajda":false},{"number":11,"text":"وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا