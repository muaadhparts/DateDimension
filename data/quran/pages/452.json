{"page":452,"blocks":[{"surah":37,"name":"سُورَةُ الصَّافَّاتِ","englishName":"As-Saaffaat","basmala":false,"juz":23,"verses":[{"number":154,"text":"مَا لَكُمْ كَيْفَ تَحْكُمُونَ","sajda":false},{"number":155,"text":"أَفَلَا تَذَكَّرُونَ","sajda":false},{"number":156,"text":"أَمْ لَكُمْ سُلْطَٰنٌۭ مُّبِينٌۭ","sajda":false},{"number":157,"text":"فَأْتُوا۟ بِكِتَٰبِكُمْ إِن كُنتُمْ صَٰدِقِينَ","sajda":false},{"number":158,"text":"وَجَعَلُوا۟ بَيْنَهُۥ وَبَيْنَ ٱلْجِنَّةِ نَسَبًۭا ۚ وَلَقَدْ عَلِمَتِ ٱلْجِنَّةُ إِنَّهُمْ لَمُحْضَرُونَ","sajda":false},{"number":159,"text":"سُبْحَٰنَ ٱللَّهِ عَمَّا يَصِفُونَ","sajda":false},{"number":160,"text":"إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ","sajda":false},{"number":161,"text":"فَإِنَّكُمْ وَمَا تَعْبُدُونَ","sajda":false},{"number":162,"text":"مَآ أَنتُمْ عَلَيْهِ بِفَٰتِنِينَ","sajda":false},{"number":163,"text":"إِلَّا مَنْ هُوَ صَالِ ٱلْجَحِيمِ","sajda":false},{"number":164,"text":"وَمَا مِنَّآ إِلَّا لَهُۥ مَقَامٌۭ مَّعْلُومٌۭ","sajda":false},{"number":165,"text":"وَإِنَّا لَنَحْنُ ٱلصَّآفُّونَ","sajda":false},{"number":166,"text":"وَإِنَّا لَنَحْنُ ٱلْمُسَبِّحُونَ","sajda":false},{"number":167,"text":"وَإِن كَانُوا۟ لَيَقُولُونَ","sajda":false},{"number":168,"text":"لَوْ أَنَّ عِندَنَا ذِكْرًۭا مِّنَ ٱلْأَوَّلِينَ","sajda":false},{"number":169,"text":"لَكُنَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ","sajda":false},{"number":170,"text":"فَكَفَرُوا۟ بِهِۦ ۖ فَسَوْفَ يَعْلَمُونَ","sajda":false},{"number":171,"text":"وَلَقَدْ سَبَقَتْ كَلِمَتُنَا لِعِبَادِنَا ٱلْمُرْسَلِينَ","sajda":false},{"number":172,"text":"إِنَّهُمْ لَهُمُ ٱلْمَنصُورُونَ","sajda":false},{"number":173,"text":"وَإِنَّ جُندَنَا لَهُمُ ٱلْغَٰلِبُونَ","sajda":false},{"number":174,"text":"فَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍۢ","sajda":false},{"number":175,"text":"وَأَبْصِرْهُمْ فَسَوْفَ يُبْصِرُونَ","sajda":false},{"number":176,"text":"أَفَبِعَذَابِنَا يَسْتَعْجِلُونَ","sajda":false},{"number":177,"text":"فَإِذَا نَزَلَ بِسَاحَتِهِمْ فَسَآءَ صَبَاحُ ٱلْمُنذَرِينَ","sajda":false},{"number":178,"text":"وَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍۢ","sajda":false},{"number":179,"text":"وَأَبْصِرْ فَسَوْفَ يُبْصِرُونَ","sajda":false},{"number":180,"text":"سُبْحَٰنَ رَبِّكَ رَبِّ ٱلْعِزَّةِ عَمَّا يَصِفُونَ","sajda":false},{"number":181,"text":"وَسَلَٰمٌ عَلَى ٱلْمُرْسَلِينَ","sajda":false},{"number":182,"text":"وَٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَٰلَمِينَ","sajda":false}]}],"juz":23}
