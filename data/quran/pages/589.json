{"page":589,"blocks":[{"surah":83,"name":"سُورَةُ المُطَفِّفِينَ","englishName":"Al-Mutaffifin","basmala":false,"juz":30,"verses":[{"number":35,"text":"عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ","sajda":false},{"number":36,"text":"هَلْ ثُوِّبَ ٱلْكُفَّارُ مَا كَانُوا۟ يَفْعَلُونَ","sajda":false}]},{"surah":84,"name":"سُورَةُ الانشِقَاقِ","englishName":"Al-Inshiqaaq","basmala":true,"juz":30,"verses":[{"number":1,"text":"إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ","sajda":false},{"number":2,"text":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ","sajda":false},{"number":3,"text":"وَإِذَا ٱلْأَرْضُ مُدَّتْ","sajda":false},{"number":4,"text":"وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ","sajda":false},{"number":5,"text":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ","sajda":false},{"number":6,"text":"يَٰٓأَيُّهَا ٱلْإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًۭا فَمُلَٰقِيهِ","sajda":false},{"number":7,"text":"فَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِيَمِينِهِۦ","sajda":false},{"number":8,"text":"فَسَوْفَ يُحَاسَبُ حِسَابًۭا يَسِيرًۭا","sajda":false},{"number":9,"text":"وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُورًۭا","sajda":false},{"number":10,"text":"وَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ وَرَآءَ ظَهْرِهِۦ","sajda":false},{"number":11,"text":"فَسَوْفَ يَدْعُوا۟ ثُبُورًۭا","sajda":false},{"number":12,"text":"وَيَصْلَىٰ سَعِيرًا","sajda":false},{"number":13,"text":"إِنَّهُۥ كَانَ فِىٓ أَهْلِهِۦ مَسْرُورًا","sajda":false},{"number":14,"text":"إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ","sajda":false},{"number":15,"text":"بَلَىٰٓ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرًۭا","sajda":false},{"number":16,"text":"فَلَآ أُقْسِمُ بِٱلشَّفَقِ","sajda":false},{"number":17,"text":"وَٱلَّيْلِ وَمَا وَسَقَ","sajda":false},{"number":18,"text":"وَٱلْقَمَرِ إِذَا ٱتَّسَقَ","sajda":false},{"number":19,"text":"لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍۢ","sajda":false},{"number":20,"text":"فَمَا لَهُمْ لَا يُؤْمِنُونَ","sajda":false},{"number":21,"text":"وَإِذَا قُرِئَ عَلَيْهِمُ ٱلْقُرْءَانُ لَا يَسْجُدُونَ ۩","sajda":true},{"number":22,"text":"بَلِ ٱلَّذِينَ كَفَرُوا۟ يُكَذِّبُونَ","sajda":false},{"number":23,"text":"وَٱللَّهُ أَعْلَمُ بِمَا يُوعُونَ","sajda":false},{"number":24,"text":"فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ","sajda":false},{"number":25,"text":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۭ","sajda":false}]}],"juz":30}
