{"page":531,"blocks":[{"surah":54,"name":"سُورَةُ القَمَرِ","englishName":"Al-Qamar","basmala":false,"juz":27,"verses":[{"number":50,"text":"وَمَآ أَمْرُنَآ إِلَّا وَٰحِدَةٌۭ كَلَمْحٍۭ بِٱلْبَصَرِ","sajda":false},{"number":51,"text":"وَلَقَدْ أَهْلَكْنَآ أَشْيَاعَكُمْ فَهَلْ مِن مُّدَّكِرٍۢ","sajda":false},{"number":52,"text":"وَكُلُّ شَىْءٍۢ فَعَلُوهُ فِى ٱلزُّبُرِ","sajda":false},{"number":53,"text":"وَكُلُّ صَغِيرٍۢ وَكَبِيرٍۢ مُّسْتَطَرٌ","sajda":false},{"number":54,"text":"إِنَّ ٱلْمُتَّقِينَ فِى جَنَّٰتٍۢ وَنَهَرٍۢ","sajda":false},{"number":55,"text":"فِى مَقْعَدِ صِدْقٍ عِندَ مَلِيكٍۢ مُّقْتَدِرٍۭ","sajda":false}]},{"surah":55,"name":"سُورَةُ الرَّحۡمَٰن","englishName":"Ar-Rahmaan","basmala":true,"juz":27,"verses":[{"number":1,"text":"ٱلرَّحْمَٰنُ","sajda":false},{"number":2,"text":"عَلَّمَ ٱلْقُرْءَانَ","sajda":false},{"number":3,"text":"خَلَقَ ٱلْإِنسَٰنَ","sajda":false},{"number":4,"text":"عَلَّمَهُ ٱلْبَيَانَ","sajda":false},{"number":5,"text":"ٱلشَّمْسُ وَٱلْقَمَرُ بِحُسْبَانٍۢ","sajda":false},{"number":6,"text":"وَٱلنَّجْمُ وَٱلشَّجَرُ يَسْجُدَانِ","sajda":false},{"number":7,"text":"وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلْمِيزَانَ","sajda":false},{"number":8,"text":"أَلَّا تَطْغَوْا۟ فِى ٱلْمِيزَانِ","sajda":false},{"number":9,"text":"وَأَقِيمُوا۟ ٱلْوَزْنَ بِٱلْقِسْطِ وَلَا تُخْسِرُوا۟ ٱلْمِيزَانَ","sajda":false},{"number":10,"text":"وَٱلْأَرْضَ وَضَعَهَا لِلْأَنَامِ","sajda":false},{"number":11,"text":"فِيهَا فَٰكِهَةٌۭ وَٱلنَّخْلُ ذَاتُ ٱلْأَكْمَامِ","sajda":false},{"number":12,"text":"وَٱلْحَبُّ ذُو ٱلْعَصْفِ وَٱلرَّيْحَانُ","sajda":false},{"number":13,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","sajda":false},{"number":14,"text":"خَلَقَ ٱلْإِنسَٰنَ مِن صَلْصَٰلٍۢ كَٱلْفَخَّارِ","sajda":false},{"number":15,"text":"وَخَلَقَ ٱلْجَآنَّ مِن مَّارِجٍۢ مِّن نَّارٍۢ","sajda":false},{"number":16,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","sajda":false}]}],"juz":27}
