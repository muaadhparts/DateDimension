{"page":534,"blocks":[{"surah":55,"name":"سُورَةُ الرَّحۡمَٰن","englishName":"Ar-Rahmaan","basmala":false,"juz":27,"verses":[{"number":68,"text":"فِيهِمَا فَٰكِهَةٌۭ وَنَخْلٌۭ وَرُمَّانٌۭ","sajda":false},{"number":69,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","sajda":false},{"number":70,"text":"فِيهِنَّ خَيْرَٰتٌ حِسَانٌۭ","sajda":false},{"number":71,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","sajda":false},{"number":72,"text":"حُورٌۭ مَّقْصُورَٰتٌۭ فِى ٱلْخِيَامِ","sajda":false},{"number":73,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","sajda":false},{"number":74,"text":"لَمْ يَطْمِثْهُنَّ إِنسٌۭ قَبْلَهُمْ وَلَا جَآنٌّۭ","sajda":false},{"number":75,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","sajda":false},{"number":76,"text":"مُتَّكِـِٔينَ عَلَىٰ رَفْرَفٍ خُضْرٍۢ وَعَبْقَرِىٍّ حِسَانٍۢ","sajda":false},{"number":77,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","sajda":false},{"number":78,"text":"تَبَٰرَكَ ٱسْمُ رَبِّكَ ذِى ٱلْجَلَٰلِ وَٱلْإِكْرَامِ","sajda":false}]},{"surah":56,"name":"سُورَةُ الوَاقِعَةِ","englishName":"Al-Waaqia","basmala":true,"juz":27,"verses":[{"number":1,"text":"إِذَا وَقَعَتِ ٱلْوَاقِعَةُ","sajda":false},{"number":2,"text":"لَيْسَ لِوَقْعَتِهَا كَاذِبَةٌ","sajda":false},{"number":3,"text":"خَافِضَةٌۭ رَّافِعَةٌ","sajda":false},{"number":4,"text":"إِذَا رُجَّتِ ٱلْأَرْضُ رَجًّۭا","sajda":false},{"number":5,"text":"وَبُسَّتِ ٱلْجِبَالُ بَسًّۭا","sajda":false},{"number":6,"text":"فَكَانَتْ هَبَآءًۭ مُّنۢبَثًّۭا","sajda":false},{"number":7,"text":"وَكُنتُمْ أَزْوَٰجًۭا ثَلَٰثَةًۭ","sajda":false},{"number":8,"text":"فَأَصْحَٰبُ ٱلْمَيْمَنَةِ مَآ أَصْحَٰبُ ٱلْمَيْمَنَةِ","sajda":false},{"number":9,"text":"وَأَصْحَٰبُ ٱلْمَشْـَٔمَةِ مَآ أَصْحَٰبُ ٱلْمَشْـَٔمَةِ","sajda":false},{"number":10,"text":"وَٱلسَّٰبِقُونَ ٱلسَّٰبِقُونَ","sajda":false},{"number":11,"text":"أُو۟لَٰٓئِكَ ٱلْمُقَرَّبُونَ","sajda":false},{"number":12,"text":"فِى جَنَّٰتِ ٱلنَّعِيمِ","sajda":false},{"number":13,"text":"ثُلَّةٌۭ مِّنَ ٱلْأَوَّلِينَ","sajda":false},{"number":14,"text":"وَقَلِيلٌۭ مِّنَ ٱلْءَاخِرِينَ","sajda":false},{"number":15,"text":"عَلَىٰ سُرُرٍۢ مَّوْضُونَةٍۢ","sajda":false},{"number":16,"text":"مُّتَّكِـِٔينَ عَلَيْهَا مُتَقَٰبِلِينَ","sajda":false}]}],"juz":27}
