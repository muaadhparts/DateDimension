{"page":582,"blocks":[{"surah":78,"name":"سُورَةُ النَّبَإِ","englishName":"An-Naba","basmala":true,"juz":30,"verses":[{"number":1,"text":"عَمَّ يَتَسَآءَلُونَ","sajda":false},{"number":2,"text":"عَنِ ٱلنَّبَإِ ٱلْعَظِيمِ","sajda":false},{"number":3,"text":"ٱلَّذِى هُمْ فِيهِ مُخْتَلِفُونَ","sajda":false},{"number":4,"text":"كَلَّا سَيَعْلَمُونَ","sajda":false},{"number":5,"text":"ثُمَّ كَلَّا سَيَعْلَمُونَ","sajda":false},{"number":6,"text":"أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَٰدًۭا","sajda":false},{"number":7,"text":"وَٱلْجِبَالَ أَوْتَادًۭا","sajda":false},{"number":8,"text":"وَخَلَقْنَٰكُمْ أَزْوَٰجًۭا","sajda":false},{"number":9,"text":"وَجَعَلْنَا نَوْمَكُمْ سُبَاتًۭا","sajda":false},{"number":10,"text":"وَجَعَلْنَا ٱلَّيْلَ لِبَاسًۭا","sajda":false},{"number":11,"text":"وَجَعَلْنَا ٱلنَّهَارَ مَعَاشًۭا","sajda":false},{"number":12,"text":"وَبَنَيْنَا فَوْقَكُمْ سَبْعًۭا شِدَادًۭا","sajda":false},{"number":13,"text":"وَجَعَلْنَا سِرَاجًۭا وَهَّاجًۭا","sajda":false},{"number":14,"text":"وَأَنزَلْنَا مِنَ ٱلْمُعْصِرَٰتِ مَآءًۭ ثَجَّاجًۭا","sajda":false},{"number":15,"text":"لِّنُخْرِجَ بِهِۦ حَبًّۭا وَنَبَاتًۭا","sajda":false},{"number":16,"text":"وَجَنَّٰتٍ أَلْفَافًا","sajda":false},{"number":17,"text":"إِنَّ يَوْمَ ٱلْفَصْلِ كَانَ مِيقَٰتًۭا","sajda":false},{"number":18,"text":"يَوْمَ يُنفَخُ فِى ٱلصُّورِ فَتَأْتُونَ أَفْوَاجًۭا","sajda":false},{"number":19,"text":"وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتْ أَبْوَٰبًۭا","sajda":false},{"number":20,"text":"وَسُيِّرَتِ ٱلْجِبَالُ فَكَانَتْ سَرَابًا","sajda":false},{"number":21,"text":"إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًۭا","sajda":false},{"number":22,"text":"لِّلطَّٰغِينَ مَـَٔابًۭا","sajda":false},{"number":23,"text":"لَّٰبِثِينَ فِيهَآ أَحْقَابًۭا","sajda":false},{"number":24,"text":"لَّا يَذُوقُونَ فِيهَا بَرْدًۭا وَلَا شَرَابًا","sajda":false},{"number":25,"text":"إِلَّا حَمِيمًۭا وَغَسَّاقًۭا","sajda":false},{"number":26,"text":"جَزَآءًۭ وِفَاقًا","sajda":false},{"number":27,"text":"إِنَّهُمْ كَانُوا۟ لَا يَرْجُونَ حِسَابًۭا","sajda":false},{"number":28,"text":"وَكَذَّبُوا۟ بِـَٔايَٰتِنَا كِذَّابًۭا","sajda":false},{"number":29,"text":"وَكُلَّ شَىْءٍ أَحْصَيْنَٰهُ كِتَٰبًۭا","sajda":false},{"number":30,"text":"فَذُوقُوا۟ فَلَن نَّزِيدَكُمْ إِلَّا عَذَابًا","sajda":false}]}],"juz":30}
