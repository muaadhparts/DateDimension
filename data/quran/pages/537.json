{"page":537,"blocks":[{"surah":56,"name":"سُورَةُ الوَاقِعَةِ","englishName":"Al-Waaqia","basmala":false,"juz":27,"verses":[{"number":77,"text":"إِنَّهُۥ لَقُرْءَانٌۭ كَرِيمٌۭ","sajda":false},{"number":78,"text":"فِى كِتَٰبٍۢ مَّكْنُونٍۢ","sajda":false},{"number":79,"text":"لَّا يَمَسُّهُۥٓ إِلَّا ٱلْمُطَهَّرُونَ","sajda":false},{"number":80,"text":"تَنزِيلٌۭ مِّن رَّبِّ ٱلْعَٰلَمِينَ","sajda":false},{"number":81,"text":"أَفَبِهَٰذَا ٱلْحَدِيثِ أَنتُم مُّدْهِنُونَ","sajda":false},{"number":82,"text":"وَتَجْعَلُونَ رِزْقَكُمْ أَنَّكُمْ تُكَذِّبُونَ","sajda":false},{"number":83,"text":"فَلَوْلَآ إِذَا بَلَغَتِ ٱلْحُلْقُومَ","sajda":false},{"number":84,"text":"وَأَنتُمْ حِينَئِذٍۢ تَنظُرُونَ","sajda":false},{"number":85,"text":"وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنكُمْ وَلَٰكِن لَّا تُبْصِرُونَ","sajda":false},{"number":86,"text":"فَلَوْلَآ إِن كُنتُمْ غَيْرَ مَدِينِينَ","sajda":false},{"number":87,"text":"تَرْجِعُونَهَآ إِن كُنتُمْ صَٰدِقِينَ","sajda":false},{"number":88,"text":"فَأَمَّآ إِن كَانَ مِنَ ٱلْمُقَرَّبِينَ","sajda":false},{"number":89,"text":"فَرَوْحٌۭ وَرَيْحَانٌۭ وَجَنَّتُ نَعِيمٍۢ","sajda":false},{"number":90,"text":"وَأَمَّآ إِن كَانَ مِنْ أَصْحَٰبِ ٱلْيَمِينِ","sajda":false},{"number":91,"text":"فَسَلَٰمٌۭ لَّكَ مِنْ أَصْحَٰبِ ٱلْيَمِينِ","sajda":false},{"number":92,"text":"وَأَمَّآ إِن كَانَ مِنَ ٱلْمُكَذِّبِينَ ٱلضَّآلِّينَ","sajda":false},{"number":93,"text":"فَنُزُلٌۭ مِّنْ حَمِيمٍۢ","sajda":false},{"number":94,"text":"وَتَصْلِيَةُ جَحِيمٍ","sajda":false},{"number":95,"text":"إِنَّ هَٰذَا لَهُوَ حَقُّ ٱلْيَقِينِ","sajda":false},{"number":96,"text":"فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ","sajda":false}]},{"surah":57,"name":"سُورَةُ الحَدِيدِ","englishName":"Al-Hadid","basmala":true,"juz":27,"verses":[{"number":1,"text":"سَبَّحَ لِلَّهِ مَا فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ ۖ وَهُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ","sajda":false},{"number":2,"text":"لَهُۥ مُلْكُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ ۖ يُحْىِۦ وَيُمِيتُ ۖ وَهُوَ عَلَىٰ كُلِّ شَىْءٍۢ قَدِيرٌ","sajda":false},{"number":3,"text":"هُوَ ٱلْأَوَّلُ وَٱلْءَاخِرُ وَٱلظَّٰهِرُ وَٱلْبَاطِنُ ۖ وَهُوَ بِكُلِّ شَىْءٍ عَلِيمٌ","sajda":false}]}],"juz":27}
