{"page":526,"blocks":[{"surah":53,"name":"سُورَةُ النَّجۡمِ","englishName":"An-Najm","basmala":true,"juz":27,"verses":[{"number":1,"text":"وَٱلنَّجْمِ إِذَا هَوَىٰ","sajda":false},{"number":2,"text":"مَا ضَلَّ صَاحِبُكُمْ وَمَا غَوَىٰ","sajda":false},{"number":3,"text":"وَمَا يَنطِقُ عَنِ ٱلْهَوَىٰٓ","sajda":false},{"number":4,"text":"إِنْ هُوَ إِلَّا وَحْىٌۭ يُوحَىٰ","sajda":false},{"number":5,"text":"عَلَّمَهُۥ شَدِيدُ ٱلْقُوَىٰ","sajda":false},{"number":6,"text":"ذُو مِرَّةٍۢ فَٱسْتَوَىٰ","sajda":false},{"number":7,"text":"وَهُوَ بِٱلْأُفُقِ ٱلْأَعْلَىٰ","sajda":false},{"number":8,"text":"ثُمَّ دَنَا فَتَدَلَّىٰ","sajda":false},{"number":9,"text":"فَكَانَ قَابَ قَوْسَيْنِ أَوْ أَدْنَىٰ","sajda":false},{"number":10,"text":"فَأَوْحَىٰٓ إِلَىٰ عَبْدِهِۦ مَآ أَوْحَىٰ","sajda":false},{"number":11,"text":"مَا كَذَبَ ٱلْفُؤَادُ مَا رَأَىٰٓ","sajda":false},{"number":12,"text":"أَفَتُمَٰرُونَهُۥ عَلَىٰ مَا يَرَىٰ","sajda":false},{"number":13,"text":"وَلَقَدْ رَءَاهُ نَزْلَةً أُخْرَىٰ","sajda":false},{"number":14,"text":"عِندَ سِدْرَةِ ٱلْمُنتَهَىٰ","sajda":false},{"number":15,"text":"عِندَهَا جَنَّةُ ٱلْمَأْوَىٰٓ","sajda":false},{"number":16,"text":"إِذْ يَغْشَى ٱلسِّدْرَةَ مَا يَغْشَىٰ","sajda":false},{"number":17,"text":"مَا زَاغَ ٱلْبَصَرُ وَمَا طَغَىٰ","sajda":false},{"number":18,"text":"لَقَدْ رَأَىٰ مِنْ ءَايَٰتِ رَبِّهِ ٱلْكُبْرَىٰٓ","sajda":false},{"number":19,"text":"أَفَرَءَيْتُمُ ٱللَّٰتَ وَٱلْعُزَّىٰ","sajda":false},{"number":20,"text":"وَمَنَوٰةَ ٱلثَّالِثَةَ ٱلْأُخْرَىٰٓ","sajda":false},{"number":21,"text":"أَلَكُمُ ٱلذَّكَرُ وَلَهُ ٱلْأُنثَىٰ","sajda":false},{"number":22,"text":"تِلْكَ إِذًۭا قِسْمَةٌۭ ضِيزَىٰٓ","sajda":false},{"number":23,"text":"إِنْ هِىَ إِلَّآ أَسْمَآءٌۭ سَمَّيْتُمُوهَآ أَنتُمْ وَءَابَآؤُكُم مَّآ أَنزَلَ ٱللَّهُ بِهَا مِن سُلْطَٰنٍ ۚ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ وَمَا تَهْوَى ٱلْأَنفُسُ ۖ وَلَقَدْ جَآءَهُم مِّن رَّبِّهِمُ ٱلْهُدَىٰٓ","sajda":false},{"number":24,"text":"أَمْ لِلْإِنسَٰنِ مَا تَمَنَّىٰ","sajda":false},{"number":25,"text":"فَلِلَّهِ ٱلْءَاخِرَةُ وَٱلْأُولَىٰ","sajda":false},{"number":26,"text":"۞ وَكَم مِّن مَّلَكٍۢ فِى ٱلسَّمَٰوَٰتِ لَا تُغْنِى شَفَٰعَتُهُمْ شَيْـًٔا إِلَّا مِنۢ بَعْدِ أَن يَأْذَنَ ٱللَّهُ لِمَن يَشَآءُ وَيَرْضَىٰٓ","sajda":false}]}],"juz":27}
