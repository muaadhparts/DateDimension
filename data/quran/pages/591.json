{"page":591,"blocks":[{"surah":86,"name":"سُورَةُ الطَّارِقِ","englishName":"At-Taariq","basmala":true,"juz":30,"verses":[{"number":1,"text":"وَٱلسَّمَآءِ وَٱلطَّارِقِ","sajda":false},{"number":2,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ","sajda":false},{"number":3,"text":"ٱلنَّجْمُ ٱلثَّاقِبُ","sajda":false},{"number":4,"text":"إِن كُلُّ نَفْسٍۢ لَّمَّا عَلَيْهَا حَافِظٌۭ","sajda":false},{"number":5,"text":"فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ","sajda":false},{"number":6,"text":"خُلِقَ مِن مَّآءٍۢ دَافِقٍۢ","sajda":false},{"number":7,"text":"يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ","sajda":false},{"number":8,"text":"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌۭ","sajda":false},{"number":9,"text":"يَوْمَ تُبْلَى ٱلسَّرَآئِرُ","sajda":false},{"number":10,"text":"فَمَا لَهُۥ مِن قُوَّةٍۢ وَلَا نَاصِرٍۢ","sajda":false},{"number":11,"text":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ","sajda":false},{"number":12,"text":"وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ","sajda":false},{"number":13,"text":"إِنَّهُۥ لَقَوْلٌۭ فَصْلٌۭ","sajda":false},{"number":14,"text":"وَمَا هُوَ بِٱلْهَزْلِ","sajda":false},{"number":15,"text":"إِنَّهُمْ يَكِيدُونَ كَيْدًۭا","sajda":false},{"number":16,"text":"وَأَكِيدُ كَيْدًۭا","sajda":false},{"number":17,"text":"فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا","sajda":false}]},{"surah":87,"name":"سُورَةُ الأَعۡلَىٰ","englishName":"Al-A'laa","basmala":true,"juz":30,"verses":[{"number":1,"text":"سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى","sajda":false},{"number":2,"text":"ٱلَّذِى خَلَقَ فَسَوَّىٰ","sajda":false},{"number":3,"text":"وَٱلَّذِى قَدَّرَ فَهَدَىٰ","sajda":false},{"number":4,"text":"وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ","sajda":false},{"number":5,"text":"فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ","sajda":false},{"number":6,"text":"سَنُقْرِئُكَ فَلَا تَنسَىٰٓ","sajda":false},{"number":7,"text":"إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ","sajda":false},{"number":8,"text":"وَنُيَسِّرُكَ لِلْيُسْرَىٰ","sajda":false},{"number":9,"text":"فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ","sajda":false},{"number":10,"text":"سَيَذَّكَّرُ مَن يَخْشَىٰ","sajda":false},{"number":11,"text":"وَيَتَجَنَّبُهَا ٱلْأَشْقَى","sajda":false},{"number":12,"text":"ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ","sajda":false},{"number":13,"text":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ","sajda":false},{"number":14,"text":"قَدْ أَفْلَحَ مَن تَزَكَّىٰ","sajda":false},{"number":15,"text":"وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ","sajda":false}]}],"juz":30}
