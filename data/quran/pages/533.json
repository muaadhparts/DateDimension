{"page":533,"blocks":[{"surah":55,"name":"سُورَةُ الرَّحۡمَٰن","englishName":"Ar-Rahmaan","basmala":false,"juz":27,"verses":[{"number":41,"text":"يُعْرَفُ ٱلْمُجْرِمُونَ بِسِيمَٰهُمْ فَيُؤْخَذُ بِٱلنَّوَٰصِى وَٱلْأَقْدَامِ","sajda":false},{"number":42,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","sajda":false},{"number":43,"text":"هَٰذِهِۦ جَهَنَّمُ ٱلَّتِى يُكَذِّبُ بِهَا ٱلْمُجْرِمُونَ","sajda":false},{"number":44,"text":"يَطُوفُونَ بَيْنَهَا وَبَيْنَ حَمِيمٍ ءَانٍۢ","sajda":false},{"number":45,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","sajda":false},{"number":46,"text":"وَلِمَنْ خَافَ مَقَامَ رَبِّهِۦ جَنَّتَانِ","sajda":false},{"number":47,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","sajda":false},{"number":48,"text":"ذَوَاتَآ أَفْنَانٍۢ","sajda":false},{"number":49,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","sajda":false},{"number":50,"text":"فِيهِمَا عَيْنَانِ تَجْرِيَانِ","sajda":false},{"number":51,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","sajda":false},{"number":52,"text":"فِيهِمَا مِن كُلِّ فَٰكِهَةٍۢ زَوْجَانِ","sajda":false},{"number":53,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","sajda":false},{"number":54,"text":"مُتَّكِـِٔينَ عَلَىٰ فُرُشٍۭ بَطَآئِنُهَا مِنْ إِسْتَبْرَقٍۢ ۚ وَجَنَى ٱلْجَنَّتَيْنِ دَانٍۢ","sajda":false},{"number":55,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","sajda":false},{"number":56,"text":"فِيهِنَّ قَٰصِرَٰتُ ٱلطَّرْفِ لَمْ يَطْمِثْهُنَّ إِنسٌۭ قَبْلَهُمْ وَلَا جَآنٌّۭ","sajda":false},{"number":57,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","sajda":false},{"number":58,"text":"كَأَنَّهُنَّ ٱلْيَاقُوتُ وَٱلْمَرْجَانُ","sajda":false},{"number":59,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","sajda":false},{"number":60,"text":"هَلْ جَزَآءُ ٱلْإِحْسَٰنِ إِلَّا ٱلْإِحْسَٰنُ","sajda":false},{"number":61,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","sajda":false},{"number":62,"text":"وَمِن دُونِهِمَا جَنَّتَانِ","sajda":false},{"number":63,"t