{"page":581,"blocks":[{"surah":77,"name":"سُورَةُ المُرۡسَلَاتِ","englishName":"Al-Mursalaat","basmala":false,"juz":29,"verses":[{"number":20,"text":"أَلَمْ نَخْلُقكُّم مِّن مَّآءٍۢ مَّهِينٍۢ","sajda":false},{"number":21,"text":"فَجَعَلْنَٰهُ فِى قَرَارٍۢ مَّكِينٍ","sajda":false},{"number":22,"text":"إِلَىٰ قَدَرٍۢ مَّعْلُومٍۢ","sajda":false},{"number":23,"text":"فَقَدَرْنَا فَنِعْمَ ٱلْقَٰدِرُونَ","sajda":false},{"number":24,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","sajda":false},{"number":25,"text":"أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا","sajda":false},{"number":26,"text":"أَحْيَآءًۭ وَأَمْوَٰتًۭا","sajda":false},{"number":27,"text":"وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَٰمِخَٰتٍۢ وَأَسْقَيْنَٰكُم مَّآءًۭ فُرَاتًۭا","sajda":false},{"number":28,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","sajda":false},{"number":29,"text":"ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ","sajda":false},{"number":30,"text":"ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّۢ ذِى ثَلَٰثِ شُعَبٍۢ","sajda":false},{"number":31,"text":"لَّا ظَلِيلٍۢ وَلَا يُغْنِى مِنَ ٱللَّهَبِ","sajda":false},{"number":32,"text":"إِنَّهَا تَرْمِى بِشَرَرٍۢ كَٱلْقَصْرِ","sajda":false},{"number":33,"text":"كَأَنَّهُۥ جِمَٰلَتٌۭ صُفْرٌۭ","sajda":false},{"number":34,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","sajda":false},{"number":35,"text":"هَٰذَا يَوْمُ لَا يَنطِقُونَ","sajda":false},{"number":36,"text":"وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ","sajda":false},{"number":37,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","sajda":false},{"number":38,"text":"هَٰذَا يَوْمُ ٱلْفَصْلِ ۖ جَمَعْنَٰكُمْ وَٱلْأَوَّلِينَ","sajda":false},{"number":39,"text":"فَإِن كَانَ لَكُمْ كَيْدٌۭ فَكِيدُونِ","sajda":false},{"number":40,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","sajda":false},{"number":41,"text":"إِنَّ ٱلْمُتَّقِينَ فِى ظِلَٰلٍۢ وَعُيُونٍۢ","sajda":false},{"number":42,"text":"وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ","sajda":false},{"number":43,"text":"كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ","sajda":false},{"number":44,"text":"إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ","sajda":false},{"number":45,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","sajda":false},{"number":46,"text":"كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ","sajda":false},{"number":47,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","sajda":false},{"number":48,"text":"وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ","sajda":false},{"number":49,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","sajda":false},{"number":50,"text":"فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ","sajda":false}]}],"juz":29}
