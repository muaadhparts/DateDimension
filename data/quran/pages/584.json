{"page":584,"blocks":[{"surah":79,"name":"سُورَةُ النَّازِعَاتِ","englishName":"An-Naazi'aat","basmala":false,"juz":30,"verses":[{"number":16,"text":"إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى","sajda":false},{"number":17,"text":"ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ","sajda":false},{"number":18,"text":"فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ","sajda":false},{"number":19,"text":"وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ","sajda":false},{"number":20,"text":"فَأَرَىٰهُ ٱلْءَايَةَ ٱلْكُبْرَىٰ","sajda":false},{"number":21,"text":"فَكَذَّبَ وَعَصَىٰ","sajda":false},{"number":22,"text":"ثُمَّ أَدْبَرَ يَسْعَىٰ","sajda":false},{"number":23,"text":"فَحَشَرَ فَنَادَىٰ","sajda":false},{"number":24,"text":"فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ","sajda":false},{"number":25,"text":"فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْءَاخِرَةِ وَٱلْأُولَىٰٓ","sajda":false},{"number":26,"text":"إِنَّ فِى ذَٰلِكَ لَعِبْرَةًۭ لِّمَن يَخْشَىٰٓ","sajda":false},{"number":27,"text":"ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ ۚ بَنَىٰهَا","sajda":false},{"number":28,"text":"رَفَعَ سَمْكَهَا فَسَوَّىٰهَا","sajda":false},{"number":29,"text":"وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا","sajda":false},{"number":30,"text":"وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ","sajda":false},{"number":31,"text":"أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَىٰهَا","sajda":false},{"number":32,"text":"وَٱلْجِبَالَ أَرْسَىٰهَا","sajda":false},{"number":33,"text":"مَتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ","sajda":false},{"number":34,"text":"فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلْكُبْرَىٰ","sajda":false},{"number":35,"text":"يَوْمَ يَتَذَكَّرُ ٱلْإِنسَٰنُ مَا سَعَىٰ","sajda":false},{"number":36,"text":"وَبُرِّزَتِ ٱلْجَحِيمُ لِمَن يَرَىٰ","sajda":false},{"number":37,"text":"فَأَمَّا مَن طَغَىٰ","sajda":false},{"number":38,"text":"وَءَاثَرَ ٱلْحَيَوٰةَ ٱلدُّنْيَا","sajda":false},{"number":39,"text":"فَإِنَّ ٱلْجَحِيمَ هِىَ ٱلْمَأْوَىٰ","sajda":false},{"number":40,"text":"وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفْسَ عَنِ ٱلْهَوَىٰ","sajda":false},{"number":41,"text":"فَإِنَّ ٱلْجَنَّةَ هِىَ ٱلْمَأْوَىٰ","sajda":false},{"number":42,"text":"يَسْـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرْسَىٰهَا","sajda":false},{"number":43,"text":"فِيمَ أَنتَ مِن ذِكْرَىٰهَآ","sajda":false},{"number":44,"text":"إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ","sajda":false},{"number":45,"text":"إِنَّمَآ أَنتَ مُنذِرُ مَن يَخْشَىٰهَا","sajda":false},{"number":46,"text":"كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوٓا۟ إِلَّا عَشِيَّةً أَوْ ضُحَىٰهَا","sajda":false}]}],"juz":30}
