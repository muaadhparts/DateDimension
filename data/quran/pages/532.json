{"page":532,"blocks":[{"surah":55,"name":"سُورَةُ الرَّحۡمَٰن","englishName":"Ar-Rahmaan","basmala":false,"juz":27,"verses":[{"number":17,"text":"رَبُّ ٱلْمَشْرِقَيْنِ وَرَبُّ ٱلْمَغْرِبَيْنِ","sajda":false},{"number":18,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","sajda":false},{"number":19,"text":"مَرَجَ ٱلْبَحْرَيْنِ يَلْتَقِيَانِ","sajda":false},{"number":20,"text":"بَيْنَهُمَا بَرْزَخٌۭ لَّا يَبْغِيَانِ","sajda":false},{"number":21,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","sajda":false},{"number":22,"text":"يَخْرُجُ مِنْهُمَا ٱللُّؤْلُؤُ وَٱلْمَرْجَانُ","sajda":false},{"number":23,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","sajda":false},{"number":24,"text":"وَلَهُ ٱلْجَوَارِ ٱلْمُنشَـَٔاتُ فِى ٱلْبَحْرِ كَٱلْأَعْلَٰمِ","sajda":false},{"number":25,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","sajda":false},{"number":26,"text":"كُلُّ مَنْ عَلَيْهَا فَانٍۢ","sajda":false},{"number":27,"text":"وَيَبْقَىٰ وَجْهُ رَبِّكَ ذُو ٱلْجَلَٰلِ وَٱلْإِكْرَامِ","sajda":false},{"number":28,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","sajda":false},{"number":29,"text":"يَسْـَٔلُهُۥ مَن فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ ۚ كُلَّ يَوْمٍ هُوَ فِى شَأْنٍۢ","sajda":false},{"number":30,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","sajda":false},{"number":31,"text":"سَنَفْرُغُ لَكُمْ أَيُّهَ ٱلثَّقَلَانِ","sajda":false},{"number":32,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","sajda":false},{"number":33,"text":"يَٰمَعْشَرَ ٱلْجِنِّ وَٱلْإِنسِ إِنِ ٱسْتَطَعْتُمْ أَن تَنفُذُوا۟ مِنْ أَقْطَارِ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ فَٱنفُذُوا۟ ۚ لَا تَنفُذُونَ إِلَّا بِسُلْطَٰنٍۢ","sajda":false},{"number":34,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","sajda":false},{"number":35,"text":"يُرْسَلُ عَلَيْكُمَا شُوَاظٌۭ مِّن نَّارٍۢ وَنُحَاسٌۭ فَلَا تَنتَصِرَانِ","sajda":false},{"number":36,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","sajda":false},{"number":37,"text":"فَإِذَا ٱنشَقَّتِ ٱلسَّمَآءُ فَكَانَتْ وَرْدَةًۭ كَٱلدِّهَانِ","sajda":false},{"number":38,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","sajda":false},{"number":39,"text":"فَيَوْمَئِذٍۢ لَّا يُسْـَٔلُ عَن ذَنۢبِهِۦٓ إِنسٌۭ وَلَا جَآنٌّۭ","sajda":false},{"number":40,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","sajda":false}]}],"juz":27}
