{"page":451,"blocks":[{"surah":37,"name":"سُورَةُ الصَّافَّاتِ","englishName":"As-Saaffaat","basmala":false,"juz":23,"verses":[{"number":127,"text":"فَكَذَّبُوهُ فَإِنَّهُمْ لَمُحْضَرُونَ","sajda":false},{"number":128,"text":"إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ","sajda":false},{"number":129,"text":"وَتَرَكْنَا عَلَيْهِ فِى ٱلْءَاخِرِينَ","sajda":false},{"number":130,"text":"سَلَٰمٌ عَلَىٰٓ إِلْ يَاسِينَ","sajda":false},{"number":131,"text":"إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ","sajda":false},{"number":132,"text":"إِنَّهُۥ مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ","sajda":false},{"number":133,"text":"وَإِنَّ لُوطًۭا لَّمِنَ ٱلْمُرْسَلِينَ","sajda":false},{"number":134,"text":"إِذْ نَجَّيْنَٰهُ وَأَهْلَهُۥٓ أَجْمَعِينَ","sajda":false},{"number":135,"text":"إِلَّا عَجُوزًۭا فِى ٱلْغَٰبِرِينَ","sajda":false},{"number":136,"text":"ثُمَّ دَمَّرْنَا ٱلْءَاخَرِينَ","sajda":false},{"number":137,"text":"وَإِنَّكُمْ لَتَمُرُّونَ عَلَيْهِم مُّصْبِحِينَ","sajda":false},{"number":138,"text":"وَبِٱلَّيْلِ ۗ أَفَلَا تَعْقِلُونَ","sajda":false},{"number":139,"text":"وَإِنَّ يُونُسَ لَمِنَ ٱلْمُرْسَلِينَ","sajda":false},{"number":140,"text":"إِذْ أَبَقَ إِلَى ٱلْفُلْكِ ٱلْمَشْحُونِ","sajda":false},{"number":141,"text":"فَسَاهَمَ فَكَانَ مِنَ ٱلْمُدْحَضِينَ","sajda":false},{"number":142,"text":"فَٱلْتَقَمَهُ ٱلْحُوتُ وَهُوَ مُلِيمٌۭ","sajda":false},{"number":143,"text":"فَلَوْلَآ أَنَّهُۥ كَانَ مِنَ ٱلْمُسَبِّحِينَ","sajda":false},{"number":144,"text":"لَلَبِثَ فِى بَطْنِهِۦٓ إِلَىٰ يَوْمِ يُبْعَثُونَ","sajda":false},{"number":145,"text":"۞ فَنَبَذْنَٰهُ بِٱلْعَرَآءِ وَهُوَ سَقِيمٌۭ","sajda":false},{"number":146,"text":"وَأَنۢبَتْنَا عَلَيْهِ شَجَرَةًۭ مِّن يَقْطِينٍۢ","sajda":false},{"number":147,"text":"وَأَرْسَلْنَٰهُ إِلَىٰ مِا۟ئَةِ أَلْفٍ أَوْ يَزِيدُونَ","sajda":false},{"number":148,"text":"فَـَٔامَنُوا۟ فَمَتَّعْنَٰهُمْ إِلَىٰ حِينٍۢ","sajda":false},{"number":149,"text":"فَٱسْتَفْتِهِمْ أَلِرَبِّكَ ٱلْبَنَاتُ وَلَهُمُ ٱلْبَنُونَ","sajda":false},{"number":150,"text":"أَمْ خَلَقْنَا ٱلْمَلَٰٓئِكَةَ إِنَٰثًۭا وَهُمْ شَٰهِدُونَ","sajda":false},{"number":151,"text":"أَلَآ إِنَّهُم مِّنْ إِفْكِهِمْ لَيَقُولُونَ","sajda":false},{"number":152,"text":"وَلَدَ ٱللَّهُ وَإِنَّهُمْ لَكَٰذِبُونَ","sajda":false},{"number":153,"text":"أَصْطَفَى ٱلْبَنَاتِ عَلَى ٱلْبَنِينَ","sajda":false}]}],"juz":23}
