{"page":583,"blocks":[{"surah":78,"name":"سُورَةُ النَّبَإِ","englishName":"An-Naba","basmala":false,"juz":30,"verses":[{"number":31,"text":"إِنَّ لِلْمُتَّقِينَ مَفَازًا","sajda":false},{"number":32,"text":"حَدَآئِقَ وَأَعْنَٰبًۭا","sajda":false},{"number":33,"text":"وَكَوَاعِبَ أَتْرَابًۭا","sajda":false},{"number":34,"text":"وَكَأْسًۭا دِهَاقًۭا","sajda":false},{"number":35,"text":"لَّا يَسْمَعُونَ فِيهَا لَغْوًۭا وَلَا كِذَّٰبًۭا","sajda":false},{"number":36,"text":"جَزَآءًۭ مِّن رَّبِّكَ عَطَآءً حِسَابًۭا","sajda":false},{"number":37,"text":"رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ٱلرَّحْمَٰنِ ۖ لَا يَمْلِكُونَ مِنْهُ خِطَابًۭا","sajda":false},{"number":38,"text":"يَوْمَ يَقُومُ ٱلرُّوحُ وَٱلْمَلَٰٓئِكَةُ صَفًّۭا ۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَٰنُ وَقَالَ صَوَابًۭا","sajda":false},{"number":39,"text":"ذَٰلِكَ ٱلْيَوْمُ ٱلْحَقُّ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا","sajda":false},{"number":40,"text":"إِنَّآ أَنذَرْنَٰكُمْ عَذَابًۭا قَرِيبًۭا يَوْمَ يَنظُرُ ٱلْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ ٱلْكَافِرُ يَٰلَيْتَنِى كُنتُ تُرَٰبًۢا","sajda":false}]},{"surah":79,"name":"سُورَةُ النَّازِعَاتِ","englishName":"An-Naazi'aat","basmala":true,"juz":30,"verses":[{"number":1,"text":"وَٱلنَّٰزِعَٰتِ غَرْقًۭا","sajda":false},{"number":2,"text":"وَٱلنَّٰشِطَٰتِ نَشْطًۭا","sajda":false},{"number":3,"text":"وَٱلسَّٰبِحَٰتِ سَبْحًۭا","sajda":false},{"number":4,"text":"فَٱلسَّٰبِقَٰتِ سَبْقًۭا","sajda":false},{"number":5,"text":"فَٱلْمُدَبِّرَٰتِ أَمْرًۭا","sajda":false},{"number":6,"text":"يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ","sajda":false},{"number":7,"text":"تَتْبَعُهَا ٱلرَّادِفَةُ","sajda":false},{"number":8,"text":"قُلُوبٌۭ يَوْمَئِذٍۢ وَاجِفَةٌ","sajda":false},{"number":9,"text":"أَبْصَٰرُهَا خَٰشِعَةٌۭ","sajda":false},{"number":10,"text":"يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ","sajda":false},{"number":11,"text":"أَءِذَا كُنَّا عِظَٰمًۭا نَّخِرَةًۭ","sajda":false},{"number":12,"text":"قَالُوا۟ تِلْكَ إِذًۭا كَرَّةٌ خَاسِرَةٌۭ","sajda":false},{"number":13,"text":"فَإِنَّمَا هِىَ زَجْرَةٌۭ وَٰحِدَةٌۭ","sajda":false},{"number":14,"text":"فَإِذَا هُم بِٱلسَّاهِرَةِ","sajda":false},{"number":15,"text":"هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ","sajda":false}]}],"juz":30}
