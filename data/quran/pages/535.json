{"page":535,"blocks":[{"surah":56,"name":"سُورَةُ الوَاقِعَةِ","englishName":"Al-Waaqia","basmala":false,"juz":27,"verses":[{"number":17,"text":"يَطُوفُ عَلَيْهِمْ وِلْدَٰنٌۭ مُّخَلَّدُونَ","sajda":false},{"number":18,"text":"بِأَكْوَابٍۢ وَأَبَارِيقَ وَكَأْسٍۢ مِّن مَّعِينٍۢ","sajda":false},{"number":19,"text":"لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزِفُونَ","sajda":false},{"number":20,"text":"وَفَٰكِهَةٍۢ مِّمَّا يَتَخَيَّرُونَ","sajda":false},{"number":21,"text":"وَلَحْمِ طَيْرٍۢ مِّمَّا يَشْتَهُونَ","sajda":false},{"number":22,"text":"وَحُورٌ عِينٌۭ","sajda":false},{"number":23,"text":"كَأَمْثَٰلِ ٱللُّؤْلُؤِ ٱلْمَكْنُونِ","sajda":false},{"number":24,"text":"جَزَآءًۢ بِمَا كَانُوا۟ يَعْمَلُونَ","sajda":false},{"number":25,"text":"لَا يَسْمَعُونَ فِيهَا لَغْوًۭا وَلَا تَأْثِيمًا","sajda":false},{"number":26,"text":"إِلَّا قِيلًۭا سَلَٰمًۭا سَلَٰمًۭا","sajda":false},{"number":27,"text":"وَأَصْحَٰبُ ٱلْيَمِينِ مَآ أَصْحَٰبُ ٱلْيَمِينِ","sajda":false},{"number":28,"text":"فِى سِدْرٍۢ مَّخْضُودٍۢ","sajda":false},{"number":29,"text":"وَطَلْحٍۢ مَّنضُودٍۢ","sajda":false},{"number":30,"text":"وَظِلٍّۢ مَّمْدُودٍۢ","sajda":false},{"number":31,"text":"وَمَآءٍۢ مَّسْكُوبٍۢ","sajda":false},{"number":32,"text":"وَفَٰكِهَةٍۢ كَثِيرَةٍۢ","sajda":false},{"number":33,"text":"لَّا مَقْطُوعَةٍۢ وَلَا مَمْنُوعَةٍۢ","sajda":false},{"number":34,"text":"وَفُرُشٍۢ مَّرْفُوعَةٍ","sajda":false},{"number":35,"text":"إِنَّآ أَنشَأْنَٰهُنَّ إِنشَآءًۭ","sajda":false},{"number":36,"text":"فَجَعَلْنَٰهُنَّ أَبْكَارًا","sajda":false},{"number":37,"text":"عُرُبًا أَتْرَابًۭا","sajda":false},{"number":38,"text":"لِّأَصْحَٰبِ ٱلْيَمِينِ","sajda":false},{"number":39,"text":"ثُلَّةٌۭ مِّنَ ٱلْأَوَّلِينَ","sajda":false},{"number":40,"text":"وَثُلَّةٌۭ مِّنَ ٱلْءَاخِرِينَ","sajda":false},{"number":41,"text":"وَأَصْحَٰبُ ٱلشِّمَالِ مَآ أَصْحَٰبُ ٱلشِّمَالِ","sajda":false},{"number":42,"text":"فِى سَمُومٍۢ وَحَمِيمٍۢ","sajda":false},{"number":43,"text":"وَظِلٍّۢ مِّن يَحْمُومٍۢ","sajda":false},{"numbe