{"page":523,"blocks":[{"surah":51,"name":"سُورَةُ الذَّارِيَاتِ","englishName":"Adh-Dhaariyat","basmala":false,"juz":27,"verses":[{"number":52,"text":"كَذَٰلِكَ مَآ أَتَى ٱلَّذِينَ مِن قَبْلِهِم مِّن رَّسُولٍ إِلَّا قَالُوا۟ سَاحِرٌ أَوْ مَجْنُونٌ","sajda":false},{"number":53,"text":"أَتَوَاصَوْا۟ بِهِۦ ۚ بَلْ هُمْ قَوْمٌۭ طَاغُونَ","sajda":false},{"number":54,"text":"فَتَوَلَّ عَنْهُمْ فَمَآ أَنتَ بِمَلُومٍۢ","sajda":false},{"number":55,"text":"وَذَكِّرْ فَإِنَّ ٱلذِّكْرَىٰ تَنفَعُ ٱلْمُؤْمِنِينَ","sajda":false},{"number":56,"text":"وَمَا خَلَقْتُ ٱلْجِنَّ وَٱلْإِنسَ إِلَّا لِيَعْبُدُونِ","sajda":false},{"number":57,"text":"مَآ أُرِيدُ مِنْهُم مِّن رِّزْقٍۢ وَمَآ أُرِيدُ أَن يُطْعِمُونِ","sajda":false},{"number":58,"text":"إِنَّ ٱللَّهَ هُوَ ٱلرَّزَّاقُ ذُو ٱلْقُوَّةِ ٱلْمَتِينُ","sajda":false},{"number":59,"text":"فَإِنَّ لِلَّذِينَ ظَلَمُوا۟ ذَنُوبًۭا مِّثْلَ ذَنُوبِ أَصْحَٰبِهِمْ فَلَا يَسْتَعْجِلُونِ","sajda":false},{"number":60,"text":"فَوَيْلٌۭ لِّلَّذِينَ كَفَرُوا۟ مِن يَوْمِهِمُ ٱلَّذِى يُوعَدُونَ","sajda":false}]},{"surah":52,"name":"سُورَةُ الطُّورِ","englishName":"At-Tur","basmala":true,"juz":27,"verses":[{"number":1,"text":"وَٱلطُّورِ","sajda":false},{"number":2,"text":"وَكِتَٰبٍۢ مَّسْطُورٍۢ","sajda":false},{"number":3,"text":"فِى رَقٍّۢ مَّنشُورٍۢ","sajda":false},{"number":4,"text":"وَٱلْبَيْتِ ٱلْمَعْمُورِ","sajda":false},{"number":5,"text":"وَٱلسَّقْفِ ٱلْمَرْفُوعِ","sajda":false},{"number":6,"text":"وَٱلْبَحْرِ ٱلْمَسْجُورِ","sajda":false},{"number":7,"text":"إِنَّ عَذَابَ رَبِّكَ لَوَٰقِعٌۭ","sajda":false},{"number":8,"text":"مَّا لَهُۥ مِن دَافِعٍۢ","sajda":false},{"number":9,"text":"يَوْمَ تَمُورُ ٱلسَّمَآءُ مَوْرًۭا","sajda":false},{"number":10,"text":"وَتَسِيرُ ٱلْجِبَالُ سَيْرًۭا","sajda":false},{"number":11,"text":"فَوَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","sajda":false},{"number":12,"text":"ٱلَّذِينَ هُمْ فِى خَوْضٍۢ يَلْعَبُونَ","sajda":false},{"number":13,"text":"يَوْمَ يُدَعُّونَ إِلَىٰ نَارِ جَهَنَّمَ دَعًّا","sajda":false},{"number":14,"text":"هَٰذِهِ ٱلنَّارُ ٱلَّتِى كُنتُم بِهَا تُكَذِّبُونَ","sajda":false}]}],"juz":27}
