{"page":266,"blocks":[{"surah":15,"name":"سُورَةُ الحِجۡرِ","englishName":"Al-Hijr","basmala":false,"juz":14,"verses":[{"number":71,"text":"قَالَ هَٰٓؤُلَآءِ بَنَاتِىٓ إِن كُنتُمْ فَٰعِلِينَ","sajda":false},{"number":72,"text":"لَعَمْرُكَ إِنَّهُمْ لَفِى سَكْرَتِهِمْ يَعْمَهُونَ","sajda":false},{"number":73,"text":"فَأَخَذَتْهُمُ ٱلصَّيْحَةُ مُشْرِقِينَ","sajda":false},{"number":74,"text":"فَجَعَلْنَا عَٰلِيَهَا سَافِلَهَا وَأَمْطَرْنَا عَلَيْهِمْ حِجَارَةًۭ مِّن سِجِّيلٍ","sajda":false},{"number":75,"text":"إِنَّ فِى ذَٰلِكَ لَءَايَٰتٍۢ لِّلْمُتَوَسِّمِينَ","sajda":false},{"number":76,"text":"وَإِنَّهَا لَبِسَبِيلٍۢ مُّقِيمٍ","sajda":false},{"number":77,"text":"إِنَّ فِى ذَٰلِكَ لَءَايَةًۭ لِّلْمُؤْمِنِينَ","sajda":false},{"number":78,"text":"وَإِن كَانَ أَصْحَٰبُ ٱلْأَيْكَةِ لَظَٰلِمِينَ","sajda":false},{"number":79,"text":"فَٱنتَقَمْنَا مِنْهُمْ وَإِنَّهُمَا لَبِإِمَامٍۢ مُّبِينٍۢ","sajda":false},{"number":80,"text":"وَلَقَدْ كَذَّبَ أَصْحَٰبُ ٱلْحِجْرِ ٱلْمُرْسَلِينَ","sajda":false},{"number":81,"text":"وَءَاتَيْنَٰهُمْ ءَايَٰتِنَا فَكَانُوا۟ عَنْهَا مُعْرِضِينَ","sajda":false},{"number":82,"text":"وَكَانُوا۟ يَنْحِتُونَ مِنَ ٱلْجِبَالِ بُيُوتًا ءَامِنِينَ","sajda":false},{"number":83,"text":"فَأَخَذَتْهُمُ ٱلصَّيْحَةُ مُصْبِحِينَ","sajda":false},{"number":84,"text":"فَمَآ أَغْنَىٰ عَنْهُم مَّا كَانُوا۟ يَكْسِبُونَ","sajda":false},{"number":85,"text":"وَمَا خَلَقْنَا ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَ وَمَا بَيْنَهُمَآ إِلَّا بِٱلْحَقِّ ۗ وَإِنَّ ٱلسَّاعَةَ لَءَاتِيَةٌۭ ۖ فَٱصْفَحِ ٱلصَّفْحَ ٱلْجَمِيلَ","sajda":false},{"number":86,"text":"إِنَّ رَبَّكَ هُوَ ٱلْخَلَّٰقُ ٱلْعَلِيمُ","sajda":false},{"number":87,"text":"وَلَقَدْ ءَاتَيْنَٰكَ سَبْعًۭا مِّنَ ٱلْمَثَانِى وَٱلْقُرْءَانَ ٱلْعَظِيمَ","sajda":false},{"number":88,"text":"لَا تَمُدَّنَّ عَيْنَيْكَ إِلَىٰ مَا مَتَّعْنَا بِهِۦٓ أَزْوَٰجًۭا مِّنْهُمْ وَلَا تَحْزَنْ عَلَيْهِمْ وَٱخْفِضْ جَنَاحَكَ لِلْمُؤْمِنِينَ","sajda":false},{"number":89,"text":"وَقُلْ إِنِّىٓ أَنَا ٱلنَّذِيرُ ٱلْمُبِينُ","sajda":false},{"number":90,"text":"كَمَآ أَنزَلْنَا عَلَى ٱلْمُقْتَسِمِينَ","sajda":false}]}],"juz":14}
