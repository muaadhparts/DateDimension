{"page":375,"blocks":[{"surah":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa","basmala":false,"juz":19,"verses":[{"number":184,"text":"وَٱتَّقُوا۟ ٱلَّذِى خَلَقَكُمْ وَٱلْجِبِلَّةَ ٱلْأَوَّلِينَ","sajda":false},{"number":185,"text":"قَالُوٓا۟ إِنَّمَآ أَنتَ مِنَ ٱلْمُسَحَّرِينَ","sajda":false},{"number":186,"text":"وَمَآ أَنتَ إِلَّا بَشَرٌۭ مِّثْلُنَا وَإِن نَّظُنُّكَ لَمِنَ ٱلْكَٰذِبِينَ","sajda":false},{"number":187,"text":"فَأَسْقِطْ عَلَيْنَا كِسَفًۭا مِّنَ ٱلسَّمَآءِ إِن كُنتَ مِنَ ٱلصَّٰدِقِينَ","sajda":false},{"number":188,"text":"قَالَ رَبِّىٓ أَعْلَمُ بِمَا تَعْمَلُونَ","sajda":false},{"number":189,"text":"فَكَذَّبُوهُ فَأَخَذَهُمْ عَذَابُ يَوْمِ ٱلظُّلَّةِ ۚ إِنَّهُۥ كَانَ عَذَابَ يَوْمٍ عَظِيمٍ","sajda":false},{"number":190,"text":"إِنَّ فِى ذَٰلِكَ لَءَايَةًۭ ۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ","sajda":false},{"number":191,"text":"وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ","sajda":false},{"number":192,"text":"وَإِنَّهُۥ لَتَنزِيلُ رَبِّ ٱلْعَٰلَمِينَ","sajda":false},{"number":193,"text":"نَزَلَ بِهِ ٱلرُّوحُ ٱلْأَمِينُ","sajda":false},{"number":194,"text":"عَلَىٰ قَلْبِكَ لِتَكُونَ مِنَ ٱلْمُنذِرِينَ","sajda":false},{"number":195,"text":"بِلِسَانٍ عَرَبِىٍّۢ مُّبِينٍۢ","sajda":false},{"number":196,"text":"وَإِنَّهُۥ لَفِى زُبُرِ ٱلْأَوَّلِينَ","sajda":false},{"number":197,"text":"أَوَلَمْ يَكُن لَّهُمْ ءَايَةً أَن يَعْلَمَهُۥ عُلَمَٰٓؤُا۟ بَنِىٓ إِسْرَٰٓءِيلَ","sajda":false},{"number":198,"text":"وَلَوْ نَزَّلْنَٰهُ عَلَىٰ بَعْضِ ٱلْأَعْجَمِينَ","sajda":false},{"number":199,"text":"فَقَرَأَهُۥ عَلَيْهِم مَّا كَانُوا۟ بِهِۦ مُؤْمِنِينَ","sajda":false},{"number":200,"text":"كَذَٰلِكَ سَلَكْنَٰهُ فِى قُلُوبِ ٱلْمُجْرِمِينَ","sajda":false},{"number":201,"text":"لَا يُؤْمِنُونَ بِهِۦ حَتَّىٰ يَرَوُا۟ ٱلْعَذَابَ ٱلْأَلِيمَ","sajda":false},{"number":202,"text":"فَيَأْتِيَهُم بَغْتَةًۭ وَهُمْ لَا يَشْعُرُونَ","sajda":false},{"number":203,"text":"فَيَقُولُوا۟ هَلْ نَحْنُ مُنظَرُونَ","sajda":false},{"number":204,"text":"أَفَبِعَذَابِنَا يَسْتَعْجِلُونَ","sajda":false},{"number":205,"text":"أَفَرَءَيْتَ إِن مَّتَّعْنَٰهُمْ سِنِينَ","sajda":false},{"number":206,"text":"ثُمَّ جَآءَهُم مَّا كَانُوا۟ يُوعَدُونَ","sajda":false}]}],"juz":19}
