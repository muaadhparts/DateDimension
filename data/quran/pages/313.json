{"page":313,"blocks":[{"surah":20,"name":"سُورَةُ طه","englishName":"Taa-Haa","basmala":false,"juz":16,"verses":[{"number":13,"text":"وَأَنَا ٱخْتَرْتُكَ فَٱسْتَمِعْ لِمَا يُوحَىٰٓ","sajda":false},{"number":14,"text":"إِنَّنِىٓ أَنَا ٱللَّهُ لَآ إِلَٰهَ إِلَّآ أَنَا۠ فَٱعْبُدْنِى وَأَقِمِ ٱلصَّلَوٰةَ لِذِكْرِىٓ","sajda":false},{"number":15,"text":"إِنَّ ٱلسَّاعَةَ ءَاتِيَةٌ أَكَادُ أُخْفِيهَا لِتُجْزَىٰ كُلُّ نَفْسٍۭ بِمَا تَسْعَىٰ","sajda":false},{"number":16,"text":"فَلَا يَصُدَّنَّكَ عَنْهَا مَن لَّا يُؤْمِنُ بِهَا وَٱتَّبَعَ هَوَىٰهُ فَتَرْدَىٰ","sajda":false},{"number":17,"text":"وَمَا تِلْكَ بِيَمِينِكَ يَٰمُوسَىٰ","sajda":false},{"number":18,"text":"قَالَ هِىَ عَصَاىَ أَتَوَكَّؤُا۟ عَلَيْهَا وَأَهُشُّ بِهَا عَلَىٰ غَنَمِى وَلِىَ فِيهَا مَـَٔارِبُ أُخْرَىٰ","sajda":false},{"number":19,"text":"قَالَ أَلْقِهَا يَٰمُوسَىٰ","sajda":false},{"number":20,"text":"فَأَلْقَىٰهَا فَإِذَا هِىَ حَيَّةٌۭ تَسْعَىٰ","sajda":false},{"number":21,"text":"قَالَ خُذْهَا وَلَا تَخَفْ ۖ سَنُعِيدُهَا سِيرَتَهَا ٱلْأُولَىٰ","sajda":false},{"number":22,"text":"وَٱضْمُمْ يَدَكَ إِلَىٰ جَنَاحِكَ تَخْرُجْ بَيْضَآءَ مِنْ غَيْرِ سُوٓءٍ ءَايَةً أُخْرَىٰ","sajda":false},{"number":23,"text":"لِنُرِيَكَ مِنْ ءَايَٰتِنَا ٱلْكُبْرَى","sajda":false},{"number":24,"text":"ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ","sajda":false},{"number":25,"text":"قَالَ رَبِّ ٱشْرَحْ لِى صَدْرِى","sajda":false},{"number":26,"text":"وَيَسِّرْ لِىٓ أَمْرِى","sajda":false},{"number":27,"text":"وَٱحْلُلْ عُقْدَةًۭ مِّن لِّسَانِى","sajda":false},{"number":28,"text":"يَفْقَهُوا۟ قَوْلِى","sajda":false},{"number":29,"text":"وَٱجْعَل لِّى وَزِيرًۭا مِّنْ أَهْلِى","sajda":false},{"number":30,"text":"هَٰرُونَ أَخِى","sajda":false},{"number":31,"text":"ٱشْدُدْ بِهِۦٓ أَزْرِى","sajda":false},{"number":32,"text":"وَأَشْرِكْهُ فِىٓ أَمْرِى","sajda":false},{"number":33,"text":"كَىْ نُسَبِّحَكَ كَثِيرًۭا","sajda":false},{"number":34,"text":"وَنَذْكُرَكَ كَثِيرًا","sajda":false},{"number":35,"text":"إِنَّكَ كُنتَ بِنَا بَصِيرًۭا","sajda":false},{"number":36,"text":"قَالَ قَدْ أُوتِيتَ سُؤْلَكَ يَٰمُوسَىٰ","sajda":false},{"number":37,"text":"وَلَقَدْ مَنَنَّا عَلَيْكَ مَرَّةً أُخْرَىٰٓ","sajda":false}]}],"juz":16}
