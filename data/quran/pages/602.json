{"page":602,"blocks":[{"surah":106,"name":"سُورَةُ قُرَيۡشٍ","englishName":"Quraish","basmala":true,"juz":30,"verses":[{"number":1,"text":"لِإِيلَٰفِ قُرَيْشٍ","sajda":false},{"number":2,"text":"إِۦلَٰفِهِمْ رِحْلَةَ ٱلشِّتَآءِ وَٱلصَّيْفِ","sajda":false},{"number":3,"text":"فَلْيَعْبُدُوا۟ رَبَّ هَٰذَا ٱلْبَيْتِ","sajda":false},{"number":4,"text":"ٱلَّذِىٓ أَطْعَمَهُم مِّن جُوعٍۢ وَءَامَنَهُم مِّنْ خَوْفٍۭ","sajda":false}]},{"surah":107,"name":"سُورَةُ المَاعُونِ","englishName":"Al-Maa'un","basmala":true,"juz":30,"verses":[{"number":1,"text":"أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","sajda":false},{"number":2,"text":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","sajda":false},{"number":3,"text":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","sajda":false},{"number":4,"text":"فَوَيْلٌۭ لِّلْمُصَلِّينَ","sajda":false},{"number":5,"text":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","sajda":false},{"number":6,"text":"ٱلَّذِينَ هُمْ يُرَآءُونَ","sajda":false},{"number":7,"text":"وَيَمْنَعُونَ ٱلْمَاعُونَ","sajda":false}]},{"surah":108,"name":"سُورَةُ الكَوۡثَرِ","englishName":"Al-Kawthar","basmala":true,"juz":30,"verses":[{"number":1,"text":"إِنَّآ أَعْطَيْنَٰكَ ٱلْكَوْثَرَ","sajda":false},{"number":2,"text":"فَصَلِّ لِرَبِّكَ وَٱنْحَرْ","sajda":false},{"number":3,"text":"إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ","sajda":false}]}],"juz":30}
