{"page":604,"blocks":[{"surah":112,"name":"سُورَةُ الإِخۡلَاصِ","englishName":"Al-Ikhlaas","basmala":true,"juz":30,"verses":[{"number":1,"text":"قُلْ هُوَ ٱللَّهُ أَحَدٌ","sajda":false},{"number":2,"text":"ٱللَّهُ ٱلصَّمَدُ","sajda":false},{"number":3,"text":"لَمْ يَلِدْ وَلَمْ يُولَدْ","sajda":false},{"number":4,"text":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","sajda":false}]},{"surah":113,"name":"سُورَةُ الفَلَقِ","englishName":"Al-Falaq","basmala":true,"juz":30,"verses":[{"number":1,"text":"قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ","sajda":false},{"number":2,"text":"مِن شَرِّ مَا خَلَقَ","sajda":false},{"number":3,"text":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ","sajda":false},{"number":4,"text":"وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِى ٱلْعُقَدِ","sajda":false},{"number":5,"text":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ","sajda":false}]},{"surah":114,"name":"سُورَةُ النَّاسِ","englishName":"An-Naas","basmala":true,"juz":30,"verses":[{"number":1,"text":"قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ","sajda":false},{"number":2,"text":"مَلِكِ ٱلنَّاسِ","sajda":false},{"number":3,"text":"إِلَٰهِ ٱلنَّاسِ","sajda":false},{"number":4,"text":"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ","sajda":false},{"number":5,"text":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ","sajda":false},{"number":6,"text":"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ","sajda":false}]}],"juz":30}
