{"page":447,"blocks":[{"surah":37,"name":"سُورَةُ الصَّافَّاتِ","englishName":"As-Saaffaat","basmala":false,"juz":23,"verses":[{"number":25,"text":"مَا لَكُمْ لَا تَنَاصَرُونَ","sajda":false},{"number":26,"text":"بَلْ هُمُ ٱلْيَوْمَ مُسْتَسْلِمُونَ","sajda":false},{"number":27,"text":"وَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍۢ يَتَسَآءَلُونَ","sajda":false},{"number":28,"text":"قَالُوٓا۟ إِنَّكُمْ كُنتُمْ تَأْتُونَنَا عَنِ ٱلْيَمِينِ","sajda":false},{"number":29,"text":"قَالُوا۟ بَل لَّمْ تَكُونُوا۟ مُؤْمِنِينَ","sajda":false},{"number":30,"text":"وَمَا كَانَ لَنَا عَلَيْكُم مِّن سُلْطَٰنٍۭ ۖ بَلْ كُنتُمْ قَوْمًۭا طَٰغِينَ","sajda":false},{"number":31,"text":"فَحَقَّ عَلَيْنَا قَوْلُ رَبِّنَآ ۖ إِنَّا لَذَآئِقُونَ","sajda":false},{"number":32,"text":"فَأَغْوَيْنَٰكُمْ إِنَّا كُنَّا غَٰوِينَ","sajda":false},{"number":33,"text":"فَإِنَّهُمْ يَوْمَئِذٍۢ فِى ٱلْعَذَابِ مُشْتَرِكُونَ","sajda":false},{"number":34,"text":"إِنَّا كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ","sajda":false},{"number":35,"text":"إِنَّهُمْ كَانُوٓا۟ إِذَا قِيلَ لَهُمْ لَآ إِلَٰهَ إِلَّا ٱللَّهُ يَسْتَكْبِرُونَ","sajda":false},{"number":36,"text":"وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓا۟ ءَالِهَتِنَا لِشَاعِرٍۢ مَّجْنُونٍۭ","sajda":false},{"number":37,"text":"بَلْ جَآءَ بِٱلْحَقِّ وَصَدَّقَ ٱلْمُرْسَلِينَ","sajda":false},{"number":38,"text":"إِنَّكُمْ لَذَآئِقُوا۟ ٱلْعَذَابِ ٱلْأَلِيمِ","sajda":false},{"number":39,"text":"وَمَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ","sajda":false},{"number":40,"text":"إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ","sajda":false},{"number":41,"text":"أُو۟لَٰٓئِكَ لَهُمْ رِزْقٌۭ مَّعْلُومٌۭ","sajda":false},{"number":42,"text":"فَوَٰكِهُ ۖ وَهُم مُّكْرَمُونَ","sajda":false},{"number":43,"text":"فِى جَنَّٰتِ ٱلنَّعِيمِ","sajda":false},{"number":44,"text":"عَلَىٰ سُرُرٍۢ مُّتَقَٰبِلِينَ","sajda":false},{"number":45,"text":"يُطَافُ عَلَيْهِم بِكَأْسٍۢ مِّن مَّعِينٍۭ","sajda":false},{"number":46,"text":"بَيْضَآءَ لَذَّةٍۢ لِّلشَّٰرِبِينَ","sajda":false},{"number":47,"text":"لَا فِيهَا غَوْلٌۭ وَلَا هُمْ عَنْهَا يُنزَفُونَ","sajda":false},{"number":48,"text":"وَعِندَهُمْ قَٰصِرَٰتُ ٱلطَّرْفِ عِينٌۭ","sajda":false},{"number":49,"text":"كَأَنَّهُنَّ بَيْضٌۭ مَّكْنُونٌۭ","sajda":false},{"number":50,"text":"فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍۢ يَتَسَآءَلُونَ","sajda":false},{"number":51,"text":"قَالَ قَآئِلٌۭ مِّنْهُمْ إِنِّى كَانَ لِى قَرِينٌۭ","sajda":false}]}],"juz":23}
