{"page":600,"blocks":[{"surah":100,"name":"سُورَةُ العَادِيَاتِ","englishName":"Al-Aadiyaat","basmala":false,"juz":30,"verses":[{"number":10,"text":"وَحُصِّلَ مَا فِى ٱلصُّدُورِ","sajda":false},{"number":11,"text":"إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍۢ لَّخَبِيرٌۢ","sajda":false}]},{"surah":101,"name":"سُورَةُ القَارِعَةِ","englishName":"Al-Qaari'a","basmala":true,"juz":30,"verses":[{"number":1,"text":"ٱلْقَارِعَةُ","sajda":false},{"number":2,"text":"مَا ٱلْقَارِعَةُ","sajda":false},{"number":3,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ","sajda":false},{"number":4,"text":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ","sajda":false},{"number":5,"text":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ","sajda":false},{"number":6,"text":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ","sajda":false},{"number":7,"text":"فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ","sajda":false},{"number":8,"text":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ","sajda":false},{"number":9,"text":"فَأُمُّهُۥ هَاوِيَةٌۭ","sajda":false},{"number":10,"text":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ","sajda":false},{"number":11,"text":"نَارٌ حَامِيَةٌۢ","sajda":false}]},{"surah":102,"name":"سُورَةُ التَّكَاثُرِ","englishName":"At-Takaathur","basmala":true,"juz":30,"verses":[{"number":1,"text":"أَلْهَىٰكُمُ ٱلتَّكَاثُرُ","sajda":false},{"number":2,"text":"حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ","sajda":false},{"number":3,"text":"كَلَّا سَوْفَ تَعْلَمُونَ","sajda":false},{"number":4,"text":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ","sajda":false},{"number":5,"text":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ","sajda":false},{"number":6,"text":"لَتَرَوُنَّ ٱلْجَحِيمَ","sajda":false},{"number":7,"text":"ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ","sajda":false},{"number":8,"text":"ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ","sajda":false}]}],"juz":30}
