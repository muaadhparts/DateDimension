{"page":594,"blocks":[{"surah":89,"name":"سُورَةُ الفَجۡرِ","englishName":"Al-Fajr","basmala":false,"juz":30,"verses":[{"number":24,"text":"يَقُولُ يَٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى","sajda":false},{"number":25,"text":"فَيَوْمَئِذٍۢ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌۭ","sajda":false},{"number":26,"text":"وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌۭ","sajda":false},{"number":27,"text":"يَٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ","sajda":false},{"number":28,"text":"ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةًۭ مَّرْضِيَّةًۭ","sajda":false},{"number":29,"text":"فَٱدْخُلِى فِى عِبَٰدِى","sajda":false},{"number":30,"text":"وَٱدْخُلِى جَنَّتِى","sajda":false}]},{"surah":90,"name":"سُورَةُ البَلَدِ","englishName":"Al-Balad","basmala":true,"juz":30,"verses":[{"number":1,"text":"لَآ أُقْسِمُ بِهَٰذَا ٱلْبَلَدِ","sajda":false},{"number":2,"text":"وَأَنتَ حِلٌّۢ بِهَٰذَا ٱلْبَلَدِ","sajda":false},{"number":3,"text":"وَوَالِدٍۢ وَمَا وَلَدَ","sajda":false},{"number":4,"text":"لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِى كَبَدٍ","sajda":false},{"number":5,"text":"أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌۭ","sajda":false},{"number":6,"text":"يَقُولُ أَهْلَكْتُ مَالًۭا لُّبَدًا","sajda":false},{"number":7,"text":"أَيَحْسَبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌ","sajda":false},{"number":8,"text":"أَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ","sajda":false},{"number":9,"text":"وَلِسَانًۭا وَشَفَتَيْنِ","sajda":false},{"number":10,"text":"وَهَدَيْنَٰهُ ٱلنَّجْدَيْنِ","sajda":false},{"number":11,"text":"فَلَا ٱقْتَحَمَ ٱلْعَقَبَةَ","sajda":false},{"number":12,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلْعَقَبَةُ","sajda":false},{"number":13,"text":"فَكُّ رَقَبَةٍ","sajda":false},{"number":14,"text":"أَوْ إِطْعَٰمٌۭ فِى يَوْمٍۢ ذِى مَسْغَبَةٍۢ","sajda":false},{"number":15,"text":"يَتِيمًۭا ذَا مَقْرَبَةٍ","sajda":false},{"number":16,"text":"أَوْ مِسْكِينًۭا ذَا مَتْرَبَةٍۢ","sajda":false},{"number":17,"text":"ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُوا۟ وَتَوَاصَوْا۟ بِٱلصَّبْرِ وَتَوَاصَوْا۟ بِٱلْمَرْحَمَةِ","sajda":false},{"number":18,"text":"أُو۟لَٰٓئِكَ أَصْحَٰبُ ٱلْمَيْمَنَةِ","sajda":false},{"number":19,"text":"وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَٰتِنَا هُمْ أَصْحَٰبُ ٱلْمَشْـَٔمَةِ","sajda":false},{"number":20,"text":"عَلَيْهِمْ نَارٌۭ مُّؤْصَدَةٌۢ","sajda":false}]}],"juz":30}
