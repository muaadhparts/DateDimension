{"number":77,"name":"سُورَةُ المُرۡسَلَاتِ","englishName":"Al-Mursalaat","englishNameTranslation":"The Emissaries","revelationType":"Meccan","basmala":true,"verses":[{"number":1,"text":"وَٱلْمُرْسَلَٰتِ عُرْفًۭا","page":580,"juz":29,"sajda":false},{"number":2,"text":"فَٱلْعَٰصِفَٰتِ عَصْفًۭا","page":580,"juz":29,"sajda":false},{"number":3,"text":"وَٱلنَّٰشِرَٰتِ نَشْرًۭا","page":580,"juz":29,"sajda":false},{"number":4,"text":"فَٱلْفَٰرِقَٰتِ فَرْقًۭا","page":580,"juz":29,"sajda":false},{"number":5,"text":"فَٱلْمُلْقِيَٰتِ ذِكْرًا","page":580,"juz":29,"sajda":false},{"number":6,"text":"عُذْرًا أَوْ نُذْرًا","page":580,"juz":29,"sajda":false},{"number":7,"text":"إِنَّمَا تُوعَدُونَ لَوَٰقِعٌۭ","page":580,"juz":29,"sajda":false},{"number":8,"text":"فَإِذَا ٱلنُّجُومُ طُمِسَتْ","page":580,"juz":29,"sajda":false},{"number":9,"text":"وَإِذَا ٱلسَّمَآءُ فُرِجَتْ","page":580,"juz":29,"sajda":false},{"number":10,"text":"وَإِذَا ٱلْجِبَالُ نُسِفَتْ","page":580,"juz":29,"sajda":false},{"number":11,"text":"وَإِذَا ٱلرُّسُلُ أُقِّتَتْ","page":580,"juz":29,"sajda":false},{"number":12,"text":"لِأَىِّ يَوْمٍ أُجِّلَتْ","page":580,"juz":29,"sajda":false},{"number":13,"text":"لِيَوْمِ ٱلْفَصْلِ","page":580,"juz":29,"sajda":false},{"number":14,"text":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ","page":580,"juz":29,"sajda":false},{"number":15,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","page":580,"juz":29,"sajda":false},{"number":16,"text":"أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ","page":580,"juz":29,"sajda":false},{"number":17,"text":"ثُمَّ نُتْبِعُهُمُ ٱلْءَاخِرِينَ","page":580,"juz":29,"sajda":false},{"number":18,"text":"كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ","page":580,"juz":29,"sajda":false},{"number":19,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","page":580,"juz":29,"sajda":false},{"number":20,"text":"أَلَمْ نَخْلُقكُّم مِّن مَّآءٍۢ مَّهِينٍۢ","page":581,"juz":29,"sajda":false},{"number":21,"text":"فَجَعَلْنَٰهُ فِى قَرَارٍۢ مَّكِينٍ","page":581,"juz":29,"sajda":false},{"number":22,"text":"إِلَىٰ قَدَرٍۢ مَّعْلُومٍۢ","page":581,"juz":29,"sajda":false},{"number":23,"text":"فَقَدَرْنَا فَنِعْمَ ٱلْقَٰدِرُونَ","page":581,"juz":29,"sajda":false},{"number":24,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","page":581,"juz":29,"sajda":false},{"number":25,"text":"أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا","page":581,"juz":29,"sajda":false},{"number":26,"text":"أَحْيَآءًۭ وَأَمْوَٰتًۭا","page":581,"juz":29,"sajda":false},{"number":27,"text":"وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَٰمِخَٰتٍۢ وَأَسْقَيْنَٰكُم مَّآءًۭ فُرَاتًۭا","page":581,"juz":29,"sajda":false},{"number":28,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","page":581,"juz":29,"sajda":false},{"number":29,"text":"ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ","page":581,"juz":29,"sajda":false},{"number":30,"text":"ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّۢ ذِى ثَلَٰثِ شُعَبٍۢ","page":581,"juz":29,"sajda":false},{"number":31,"text":"لَّا ظَلِيلٍۢ وَلَا يُغْنِى مِنَ ٱللَّهَبِ","page":581,"juz":29,"sajda":false},{"number":32,"text":"إِنَّهَا تَرْمِى بِشَرَرٍۢ كَٱلْقَصْرِ","page":581,"juz":29,"sajda":false},{"number":33,"text":"كَأَنَّهُۥ جِمَٰلَتٌۭ صُفْرٌۭ","page":581,"juz":29,"sajda":false},{"number":34,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","page":581,"juz":29,"sajda":false},{"number":35,"text":"هَٰذَا يَوْمُ لَا يَنطِقُونَ","page":581,"juz":29,"sajda":false},{"number":36,"text":"وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ","page":581,"juz":29,"sajda":false},{"number":37,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","page":581,"juz":29,"sajda":false},{"number":38,"text":"هَٰذَا يَوْمُ ٱلْفَصْلِ ۖ جَمَعْنَٰكُمْ وَٱلْأَوَّلِينَ","page":581,"juz":29,"sajda":false},{"number":39,"text":"فَإِن كَانَ لَكُمْ كَيْدٌۭ فَكِيدُونِ","page":581,"juz":29,"sajda":false},{"number":40,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","page":581,"juz":29,"sajda":false},{"number":41,"text":"إِنَّ ٱلْمُتَّقِينَ فِى ظِلَٰلٍۢ وَعُيُونٍۢ","page":581,"juz":29,"sajda":false},{"number":42,"text":"وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ","page":581,"juz":29,"sajda":false},{"number":43,"text":"كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ","page":581,"juz":29,"sajda":false},{"number":44,"text":"إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ","page":581,"juz":29,"sajda":false},{"number":45,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","page":581,"juz":29,"sajda":false},{"number":46,"text":"كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ","page":581,"juz":29,"sajda":false},{"number":47,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","page":581,"juz":29,"sajda":false},{"number":48,"text":"وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ","page":581,"juz":29,"sajda":false},{"number":49,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","page":581,"juz":29,"sajda":false},{"number":50,"text":"فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ","page":581,"juz":29,"sajda":false}]}
