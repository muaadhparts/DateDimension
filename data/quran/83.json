{"number":83,"name":"سُورَةُ المُطَفِّفِينَ","englishName":"Al-Mutaffifin","englishNameTranslation":"Defrauding","revelationType":"Meccan","basmala":true,"verses":[{"number":1,"text":"وَيْلٌۭ لِّلْمُطَفِّفِينَ","page":587,"juz":30,"sajda":false},{"number":2,"text":"ٱلَّذِينَ إِذَا ٱكْتَالُوا۟ عَلَى ٱلنَّاسِ يَسْتَوْفُونَ","page":587,"juz":30,"sajda":false},{"number":3,"text":"وَإِذَا كَالُوهُمْ أَو وَّزَنُوهُمْ يُخْسِرُونَ","page":587,"juz":30,"sajda":false},{"number":4,"text":"أَلَا يَظُنُّ أُو۟لَٰٓئِكَ أَنَّهُم مَّبْعُوثُونَ","page":587,"juz":30,"sajda":false},{"number":5,"text":"لِيَوْمٍ عَظِيمٍۢ","page":587,"juz":30,"sajda":false},{"number":6,"text":"يَوْمَ يَقُومُ ٱلنَّاسُ لِرَبِّ ٱلْعَٰلَمِينَ","page":587,"juz":30,"sajda":false},{"number":7,"text":"كَلَّآ إِنَّ كِتَٰبَ ٱلْفُجَّارِ لَفِى سِجِّينٍۢ","page":588,"juz":30,"sajda":false},{"number":8,"text":"وَمَآ أَدْرَىٰكَ مَا سِجِّينٌۭ","page":588,"juz":30,"sajda":false},{"number":9,"text":"كِتَٰبٌۭ مَّرْقُومٌۭ","page":588,"juz":30,"sajda":false},{"number":10,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","page":588,"juz":30,"sajda":false},{"number":11,"text":"ٱلَّذِينَ يُكَذِّبُونَ بِيَوْمِ ٱلدِّينِ","page":588,"juz":30,"sajda":false},{"number":12,"text":"وَمَا يُكَذِّبُ بِهِۦٓ إِلَّا كُلُّ مُعْتَدٍ أَثِيمٍ","page":588,"juz":30,"sajda":false},{"number":13,"text":"إِذَا تُتْلَىٰ عَلَيْهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلْأَوَّلِينَ","page":588,"juz":30,"sajda":false},{"number":14,"text":"كَلَّا ۖ بَلْ ۜ رَانَ عَلَىٰ قُلُوبِهِم مَّا كَانُوا۟ يَكْسِبُونَ","page":588,"juz":30,"sajda":false},{"number":15,"text":"كَلَّآ إِنَّهُمْ عَن رَّبِّهِمْ يَوْمَئِذٍۢ لَّمَحْجُوبُونَ","page":588,"juz":30,"sajda":false},{"number":16,"text":"ثُمَّ إِنَّهُمْ لَصَالُوا۟ ٱلْجَحِيمِ","page":588,"juz":30,"sajda":false},{"number":17,"text":"ثُمَّ يُقَالُ هَٰذَا ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ","page":588,"juz":30,"sajda":false},{"number":18,"text":"كَلَّآ إِنَّ كِتَٰبَ ٱلْأَبْرَارِ لَفِى عِلِّيِّينَ","page":588,"juz":30,"sajda":false},{"number":19,"text":"وَمَآ أَدْرَىٰكَ مَا عِلِّيُّونَ","page":588,"juz":30,"sajda":false},{"number":20,"text":"كِتَٰبٌۭ مَّرْقُومٌۭ","page":588,"juz":30,"sajda":false},{"number":21,"text":"يَشْهَدُهُ ٱلْمُقَرَّبُونَ","page":588,"juz":30,"sajda":false},{"number":22,"text":"إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ","page":588,"juz":30,"sajda":false},{"number":23,"text":"عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ","page":588,"juz":30,"sajda":false},{"number":24,"text":"تَعْرِفُ فِى وُجُوهِهِمْ نَضْرَةَ ٱلنَّعِيمِ","page":588,"juz":30,"sajda":false},{"number":25,"text":"يُسْقَوْنَ مِن رَّحِيقٍۢ مَّخْتُومٍ","page":588,"juz":30,"sajda":false},{"number":26,"text":"خِتَٰمُهُۥ مِسْكٌۭ ۚ وَفِى ذَٰلِكَ فَلْيَتَنَافَسِ ٱلْمُتَنَٰفِسُونَ","page":588,"juz":30,"sajda":false},{"number":27,"text":"وَمِزَاجُهُۥ مِن تَسْنِيمٍ","page":588,"juz":30,"sajda":false},{"number":28,"text":"عَيْنًۭا يَشْرَبُ بِهَا ٱلْمُقَرَّبُونَ","page":588,"juz":30,"sajda":false},{"number":29,"text":"إِنَّ ٱلَّذِينَ أَجْرَمُوا۟ كَانُوا۟ مِنَ ٱلَّذِينَ ءَامَنُوا۟ يَضْحَكُونَ","page":588,"juz":30,"sajda":false},{"number":30,"text":"وَإِذَا مَرُّوا۟ بِهِمْ يَتَغَامَزُونَ","page":588,"juz":30,"sajda":false},{"number":31,"text":"وَإِذَا ٱنقَلَبُوٓا۟ إِلَىٰٓ أَهْلِهِمُ ٱنقَلَبُوا۟ فَكِهِينَ","page":588,"juz":30,"sajda":false},{"number":32,"text":"وَإِذَا رَأَوْهُمْ قَالُوٓا۟ إِنَّ هَٰٓؤُلَآءِ لَضَآلُّونَ","page":588,"juz":30,"sajda":false},{"number":33,"text":"وَمَآ أُرْسِلُوا۟ عَلَيْهِمْ حَٰفِظِينَ","page":588,"juz":30,"sajda":false},{"number":34,"text":"فَٱلْيَوْمَ ٱلَّذِينَ ءَامَنُوا۟ مِنَ ٱلْكُفَّارِ يَضْحَكُونَ","page":588,"juz":30,"sajda":false},{"number":35,"text":"عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ","page":589,"juz":30,"sajda":false},{"number":36,"text":"هَلْ ثُوِّبَ ٱلْكُفَّارُ مَا كَانُوا۟ يَفْعَلُونَ","page":589,"juz":30,"sajda":false}]}
