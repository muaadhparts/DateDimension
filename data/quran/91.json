{"number":91,"name":"سُورَةُ الشَّمۡسِ","englishName":"Ash-Shams","englishNameTranslation":"The Sun","revelationType":"Meccan","basmala":true,"verses":[{"number":1,"text":"وَٱلشَّمْسِ وَضُحَىٰهَا","page":595,"juz":30,"sajda":false},{"number":2,"text":"وَٱلْقَمَرِ إِذَا تَلَىٰهَا","page":595,"juz":30,"sajda":false},{"number":3,"text":"وَٱلنَّهَارِ إِذَا جَلَّىٰهَا","page":595,"juz":30,"sajda":false},{"number":4,"text":"وَٱلَّيْلِ إِذَا يَغْشَىٰهَا","page":595,"juz":30,"sajda":false},{"number":5,"text":"وَٱلسَّمَآءِ وَمَا بَنَىٰهَا","page":595,"juz":30,"sajda":false},{"number":6,"text":"وَٱلْأَرْضِ وَمَا طَحَىٰهَا","page":595,"juz":30,"sajda":false},{"number":7,"text":"وَنَفْسٍۢ وَمَا سَوَّىٰهَا","page":595,"juz":30,"sajda":false},{"number":8,"text":"فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا","page":595,"juz":30,"sajda":false},{"number":9,"text":"قَدْ أَفْلَحَ مَن زَكَّىٰهَا","page":595,"juz":30,"sajda":false},{"number":10,"text":"وَقَدْ خَابَ مَن دَسَّىٰهَا","page":595,"juz":30,"sajda":false},{"number":11,"text":"كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ","page":595,"juz":30,"sajda":false},{"number":12,"text":"إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا","page":595,"juz":30,"sajda":false},{"number":13,"text":"فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَٰهَا","page":595,"juz":30,"sajda":false},{"number":14,"text":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا","page":595,"juz":30,"sajda":false},{"number":15,"text":"وَلَا يَخَافُ عُقْبَٰهَا","page":595,"juz":30,"sajda":false}]}
