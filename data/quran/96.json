{"number":96,"name":"سُورَةُ العَلَقِ","englishName":"Al-Alaq","englishNameTranslation":"The Clot","revelationType":"Meccan","basmala":true,"verses":[{"number":1,"text":"ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ","page":597,"juz":30,"sajda":false},{"number":2,"text":"خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ","page":597,"juz":30,"sajda":false},{"number":3,"text":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ","page":597,"juz":30,"sajda":false},{"number":4,"text":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ","page":597,"juz":30,"sajda":false},{"number":5,"text":"عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ","page":597,"juz":30,"sajda":false},{"number":6,"text":"كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ","page":597,"juz":30,"sajda":false},{"number":7,"text":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ","page":597,"juz":30,"sajda":false},{"number":8,"text":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ","page":597,"juz":30,"sajda":false},{"number":9,"text":"أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ","page":597,"juz":30,"sajda":false},{"number":10,"text":"عَبْدًا إِذَا صَلَّىٰٓ","page":597,"juz":30,"sajda":false},{"number":11,"text":"أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ","page":597,"juz":30,"sajda":false},{"number":12,"text":"أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ","page":597,"juz":30,"sajda":false},{"number":13,"text":"أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","page":597,"juz":30,"sajda":false},{"number":14,"text":"أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ","page":597,"juz":30,"sajda":false},{"number":15,"text":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ","page":597,"juz":30,"sajda":false},{"number":16,"text":"نَاصِيَةٍۢ كَٰذِبَةٍ خَاطِئَةٍۢ","page":597,"juz":30,"sajda":false},{"number":17,"text":"فَلْيَدْعُ نَادِيَهُۥ","page":597,"juz":30,"sajda":false},{"number":18,"text":"سَنَدْعُ ٱلزَّبَانِيَةَ","page":597,"juz":30,"sajda":false},{"number":19,"text":"كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩","page":597,"juz":30,"sajda":true}]}
