{"number":92,"name":"سُورَةُ اللَّيۡلِ","englishName":"Al-Lail","englishNameTranslation":"The Night","revelationType":"Meccan","basmala":true,"verses":[{"number":1,"text":"وَٱلَّيْلِ إِذَا يَغْشَىٰ","page":595,"juz":30,"sajda":false},{"number":2,"text":"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ","page":595,"juz":30,"sajda":false},{"number":3,"text":"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ","page":595,"juz":30,"sajda":false},{"number":4,"text":"إِنَّ سَعْيَكُمْ لَشَتَّىٰ","page":595,"juz":30,"sajda":false},{"number":5,"text":"فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ","page":595,"juz":30,"sajda":false},{"number":6,"text":"وَصَدَّقَ بِٱلْحُسْنَىٰ","page":595,"juz":30,"sajda":false},{"number":7,"text":"فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ","page":595,"juz":30,"sajda":false},{"number":8,"text":"وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ","page":595,"juz":30,"sajda":false},{"number":9,"text":"وَكَذَّبَ بِٱلْحُسْنَىٰ","page":595,"juz":30,"sajda":false},{"number":10,"text":"فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ","page":595,"juz":30,"sajda":false},{"number":11,"text":"وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ","page":595,"juz":30,"sajda":false},{"number":12,"text":"إِنَّ عَلَيْنَا لَلْهُدَىٰ","page":595,"juz":30,"sajda":false},{"number":13,"text":"وَإِنَّ لَنَا لَلْءَاخِرَةَ وَٱلْأُولَىٰ","page":595,"juz":30,"sajda":false},{"number":14,"text":"فَأَنذَرْتُكُمْ نَارًۭا تَلَظَّىٰ","page":595,"juz":30,"sajda":false},{"number":15,"text":"لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى","page":596,"juz":30,"sajda":false},{"number":16,"text":"ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ","page":596,"juz":30,"sajda":false},{"number":17,"text":"وَسَيُجَنَّبُهَا ٱلْأَتْقَى","page":596,"juz":30,"sajda":false},{"number":18,"text":"ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ","page":596,"juz":30,"sajda":false},{"number":19,"text":"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍۢ تُجْزَىٰٓ","page":596,"juz":30,"sajda":false},{"number":20,"text":"إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ","page":596,"juz":30,"sajda":false},{"number":21,"text":"وَلَسَوْفَ يَرْضَىٰ","page":596,"juz":30,"sajda":false}]}
