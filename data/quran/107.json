{"number":107,"name":"سُورَةُ المَاعُونِ","englishName":"Al-Maa'un","englishNameTranslation":"Almsgiving","revelationType":"Meccan","basmala":true,"verses":[{"number":1,"text":"أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","page":602,"juz":30,"sajda":false},{"number":2,"text":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","page":602,"juz":30,"sajda":false},{"number":3,"text":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","page":602,"juz":30,"sajda":false},{"number":4,"text":"فَوَيْلٌۭ لِّلْمُصَلِّينَ","page":602,"juz":30,"sajda":false},{"number":5,"text":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","page":602,"juz":30,"sajda":false},{"number":6,"text":"ٱلَّذِينَ هُمْ يُرَآءُونَ","page":602,"juz":30,"sajda":false},{"number":7,"text":"وَيَمْنَعُونَ ٱلْمَاعُونَ","page":602,"juz":30,"sajda":false}]}
