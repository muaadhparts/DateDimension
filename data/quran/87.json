{"number":87,"name":"سُورَةُ الأَعۡلَىٰ","englishName":"Al-A'laa","englishNameTranslation":"The Most High","revelationType":"Meccan","basmala":true,"verses":[{"number":1,"text":"سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى","page":591,"juz":30,"sajda":false},{"number":2,"text":"ٱلَّذِى خَلَقَ فَسَوَّىٰ","page":591,"juz":30,"sajda":false},{"number":3,"text":"وَٱلَّذِى قَدَّرَ فَهَدَىٰ","page":591,"juz":30,"sajda":false},{"number":4,"text":"وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ","page":591,"juz":30,"sajda":false},{"number":5,"text":"فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ","page":591,"juz":30,"sajda":false},{"number":6,"text":"سَنُقْرِئُكَ فَلَا تَنسَىٰٓ","page":591,"juz":30,"sajda":false},{"number":7,"text":"إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ","page":591,"juz":30,"sajda":false},{"number":8,"text":"وَنُيَسِّرُكَ لِلْيُسْرَىٰ","page":591,"juz":30,"sajda":false},{"number":9,"text":"فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ","page":591,"juz":30,"sajda":false},{"number":10,"text":"سَيَذَّكَّرُ مَن يَخْشَىٰ","page":591,"juz":30,"sajda":false},{"number":11,"text":"وَيَتَجَنَّبُهَا ٱلْأَشْقَى","page":591,"juz":30,"sajda":false},{"number":12,"text":"ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ","page":591,"juz":30,"sajda":false},{"number":13,"text":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ","page":591,"juz":30,"sajda":false},{"number":14,"text":"قَدْ أَفْلَحَ مَن تَزَكَّىٰ","page":591,"juz":30,"sajda":false},{"number":15,"text":"وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ","page":591,"juz":30,"sajda":false},{"number":16,"text":"بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا","page":592,"juz":30,"sajda":false},{"number":17,"text":"وَٱلْءَاخِرَةُ خَيْرٌۭ وَأَبْقَىٰٓ","page":592,"juz":30,"sajda":false},{"number":18,"text":"إِنَّ هَٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ","page":592,"juz":30,"sajda":false},{"number":19,"text":"صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ","page":592,"juz":30,"sajda":false}]}
