{"number":93,"name":"سُورَةُ الضُّحَىٰ","englishName":"Ad-Dhuhaa","englishNameTranslation":"The Morning Hours","revelationType":"Meccan","basmala":true,"verses":[{"number":1,"text":"وَٱلضُّحَىٰ","page":596,"juz":30,"sajda":false},{"number":2,"text":"وَٱلَّيْلِ إِذَا سَجَىٰ","page":596,"juz":30,"sajda":false},{"number":3,"text":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ","page":596,"juz":30,"sajda":false},{"number":4,"text":"وَلَلْءَاخِرَةُ خَيْرٌۭ لَّكَ مِنَ ٱلْأُولَىٰ","page":596,"juz":30,"sajda":false},{"number":5,"text":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ","page":596,"juz":30,"sajda":false},{"number":6,"text":"أَلَمْ يَجِدْكَ يَتِيمًۭا فَـَٔاوَىٰ","page":596,"juz":30,"sajda":false},{"number":7,"text":"وَوَجَدَكَ ضَآلًّۭا فَهَدَىٰ","page":596,"juz":30,"sajda":false},{"number":8,"text":"وَوَجَدَكَ عَآئِلًۭا فَأَغْنَىٰ","page":596,"juz":30,"sajda":false},{"number":9,"text":"فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ","page":596,"juz":30,"sajda":false},{"number":10,"text":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ","page":596,"juz":30,"sajda":false},{"number":11,"text":"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ","page":596,"juz":30,"sajda":false}]}
