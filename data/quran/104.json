{"number":104,"name":"سُورَةُ الهُمَزَةِ","englishName":"Al-Humaza","englishNameTranslation":"The Traducer","revelationType":"Meccan","basmala":true,"verses":[{"number":1,"text":"وَيْلٌۭ لِّكُلِّ هُمَزَةٍۢ لُّمَزَةٍ","page":601,"juz":30,"sajda":false},{"number":2,"text":"ٱلَّذِى جَمَعَ مَالًۭا وَعَدَّدَهُۥ","page":601,"juz":30,"sajda":false},{"number":3,"text":"يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ","page":601,"juz":30,"sajda":false},{"number":4,"text":"كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ","page":601,"juz":30,"sajda":false},{"number":5,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ","page":601,"juz":30,"sajda":false},{"number":6,"text":"نَارُ ٱللَّهِ ٱلْمُوقَدَةُ","page":601,"juz":30,"sajda":false},{"number":7,"text":"ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ","page":601,"juz":30,"sajda":false},{"number":8,"text":"إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌۭ","page":601,"juz":30,"sajda":false},{"number":9,"text":"فِى عَمَدٍۢ مُّمَدَّدَةٍۭ","page":601,"juz":30,"sajda":false}]}
