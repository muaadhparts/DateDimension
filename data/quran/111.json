{"number":111,"name":"سُورَةُ المَسَدِ","englishName":"Al-Masad","englishNameTranslation":"The Palm Fibre","revelationType":"Meccan","basmala":true,"verses":[{"number":1,"text":"تَبَّتْ يَدَآ أَبِى لَهَبٍۢ وَتَبَّ","page":603,"juz":30,"sajda":false},{"number":2,"text":"مَآ أَغْنَىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَ","page":603,"juz":30,"sajda":false},{"number":3,"text":"سَيَصْلَىٰ نَارًۭا ذَاتَ لَهَبٍۢ","page":603,"juz":30,"sajda":false},{"number":4,"text":"وَٱمْرَأَتُهُۥ حَمَّالَةَ ٱلْحَطَبِ","page":603,"juz":30,"sajda":false},{"number":5,"text":"فِى جِيدِهَا حَبْلٌۭ مِّن مَّسَدٍۭ","page":603,"juz":30,"sajda":false}]}
