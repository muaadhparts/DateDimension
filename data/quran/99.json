{"number":99,"name":"سُورَةُ الزَّلۡزَلَةِ","englishName":"Az-Zalzala","englishNameTranslation":"The Earthquake","revelationType":"Medinan","basmala":true,"verses":[{"number":1,"text":"إِذَا زُلْزِلَتِ ٱلْأَرْضُ زِلْزَالَهَا","page":599,"juz":30,"sajda":false},{"number":2,"text":"وَأَخْرَجَتِ ٱلْأَرْضُ أَثْقَالَهَا","page":599,"juz":30,"sajda":false},{"number":3,"text":"وَقَالَ ٱلْإِنسَٰنُ مَا لَهَا","page":599,"juz":30,"sajda":false},{"number":4,"text":"يَوْمَئِذٍۢ تُحَدِّثُ أَخْبَارَهَا","page":599,"juz":30,"sajda":false},{"number":5,"text":"بِأَنَّ رَبَّكَ أَوْحَىٰ لَهَا","page":599,"juz":30,"sajda":false},{"number":6,"text":"يَوْمَئِذٍۢ يَصْدُرُ ٱلنَّاسُ أَشْتَاتًۭا لِّيُرَوْا۟ أَعْمَٰلَهُمْ","page":599,"juz":30,"sajda":false},{"number":7,"text":"فَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًۭا يَرَهُۥ","page":599,"juz":30,"sajda":false},{"number":8,"text":"وَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍۢ شَرًّۭا يَرَهُۥ","page":599,"juz":30,"sajda":false}]}
