# The canonical public HTTPS origin. Every canonical URL, hreflang alternate,
# sitemap entry and JSON-LD id is built from it.
SITE_URL=https://yourdaynow.online
# Search engines may index the site only when this is exactly "true".
PUBLIC_INDEXING=true

# Encrypts the credentials table (lib/credentials.ts, AES-256-GCM). Generate
# one with `npm run credentials -- generate-key`. Changing it makes every
# stored credential unreadable, so rotate it only together with the values.
APP_KEY=
# Optional. Where the credentials table lives; by default storage/ beside this
# file, which on Forge is the site root and survives every release.
# CREDENTIALS_DB=

# The Google Maps Platform key belongs in the encrypted table, not here:
#   npm run credentials -- set google_maps api_key < key.txt
# It turns the visitor's granted coordinates into a place name, covers cities
# the free geocoder misses, and runs the national address page (geocoding on
# the server; the map itself loads Google's script with the key in its URL).
# This variable is only a fallback for a deployment without the table.
GOOGLE_MAPS_API_KEY=
