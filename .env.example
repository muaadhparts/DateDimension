# The canonical public HTTPS origin. Every canonical URL, hreflang alternate,
# sitemap entry and JSON-LD id is built from it.
SITE_URL=https://yourdaynow.online
# Search engines may index the site only when this is exactly "true".
PUBLIC_INDEXING=true

# Optional. Server-side only: turns the visitor's granted coordinates into a
# place name, and covers cities the free geocoder misses. The browser never
# receives it. Without it the site still works — coordinates give times, only
# the place name is missing.
GOOGLE_MAPS_API_KEY=
